pipeline {

    agent any

    options {
        timestamps()
        skipDefaultCheckout(false)
        disableConcurrentBuilds()
    }

    parameters {

        string(
            name: 'EC2_IP',
            defaultValue: '18.213.199.167',
            description: 'AWS EC2 Elastic IP address'
        )

        string(
            name: 'EC2_USER',
            defaultValue: 'ubuntu',
            description: 'AWS EC2 SSH username'
        )

        string(
            name: 'DOCKERHUB_USER',
            defaultValue: 'varun1716',
            description: 'Docker Hub username'
        )

        booleanParam(
            name: 'SONAR_ENABLED',
            defaultValue: false,
            description: 'Enable SonarQube analysis'
        )

        booleanParam(
            name: 'K8S_ENABLED',
            defaultValue: false,
            description: 'Enable Kubernetes deployment'
        )
    }

    environment {

        APP_DIR = 'fooddeliveryapp'

        APP_PORT = '8083'

        AWS_HOST_PORT = '80'

        IMAGE_NAME = 'food-delivery'

        DOCKER_IMAGE = "${params.DOCKERHUB_USER}/${IMAGE_NAME}:${BUILD_NUMBER}"

        DOCKER_LATEST = "${params.DOCKERHUB_USER}/${IMAGE_NAME}:latest"

        RENDER_URL = 'https://food-delivery-render.onrender.com'

        DOCKER_CREDENTIAL_ID = 'dockercred1'

        SSH_CREDENTIAL_ID = 'ec2-ssh-key'

        RENDER_DEPLOY_HOOK_CREDENTIAL_ID = 'render-deploy-hook'
    }

    stages {

        stage('Environment Validation') {

            steps {

                echo ''
                echo '============================================================'
                echo 'MULTI-CLOUD CI/CD PIPELINE'
                echo '============================================================'
                echo ''
                echo "Jenkins Agent       : Windows"
                echo "Application         : Food Delivery Sample"
                echo "Application Dir     : ${APP_DIR}"
                echo "Application Port    : ${APP_PORT}"
                echo "Docker Image        : ${DOCKER_IMAGE}"
                echo "AWS EC2             : ${params.EC2_IP}"
                echo "AWS Host Port       : ${AWS_HOST_PORT}"
                echo "Render URL          : ${RENDER_URL}"
                echo "SonarQube Enabled   : ${params.SONAR_ENABLED}"
                echo "Kubernetes Enabled  : ${params.K8S_ENABLED}"
                echo ''

                bat '''
                    echo.
                    echo Checking Java...
                    java -version
                    if errorlevel 1 (
                        echo ERROR: Java is not available.
                        exit /b 1
                    )

                    echo.
                    echo Checking Maven Wrapper...
                    cd /d "%WORKSPACE%\\fooddeliveryapp"

                    if not exist "mvnw.cmd" (
                        echo ERROR: mvnw.cmd was not found.
                        exit /b 1
                    )

                    mvnw.cmd --version
                    if errorlevel 1 (
                        echo ERROR: Maven Wrapper is not working.
                        exit /b 1
                    )

                    echo.
                    echo Checking Docker...
                    docker --version
                    if errorlevel 1 (
                        echo ERROR: Docker is not available.
                        exit /b 1
                    )

                    echo.
                    echo Checking Git...
                    git --version
                    if errorlevel 1 (
                        echo ERROR: Git is not available.
                        exit /b 1
                    )

                    echo.
                    echo Checking SSH...
                    ssh -V

                    echo.
                    echo Checking SCP...
                    where scp

                    echo.
                    echo Environment validation completed successfully.
                '''
            }
        }

        stage('Maven Test') {

            steps {

                dir("${APP_DIR}") {

                    bat '''
                        echo.
                        echo ============================================================
                        echo MAVEN UNIT TESTS
                        echo ============================================================
                        echo.

                        mvnw.cmd clean test

                        if errorlevel 1 (
                            echo ERROR: Maven tests failed.
                            exit /b 1
                        )

                        echo.
                        echo Maven tests completed successfully.
                    '''
                }
            }
        }

        stage('Maven Package') {

            steps {

                dir("${APP_DIR}") {

                    bat '''
                        echo.
                        echo ============================================================
                        echo MAVEN PACKAGE
                        echo ============================================================
                        echo.

                        mvnw.cmd package -DskipTests

                        if errorlevel 1 (
                            echo ERROR: Maven package failed.
                            exit /b 1
                        )

                        echo.
                        echo Maven package completed successfully.
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {

            when {
                expression {
                    return params.SONAR_ENABLED
                }
            }

            steps {

                dir("${APP_DIR}") {

                    withCredentials([
                        string(
                            credentialsId: 'CseSonar',
                            variable: 'SONAR_TOKEN'
                        )
                    ]) {

                        bat '''
                            echo.
                            echo ============================================================
                            echo SONARQUBE ANALYSIS
                            echo ============================================================
                            echo.

                            mvnw.cmd sonar:sonar ^
                                -Dsonar.token=%SONAR_TOKEN%

                            if errorlevel 1 (
                                echo ERROR: SonarQube analysis failed.
                                exit /b 1
                            )

                            echo.
                            echo SonarQube analysis completed successfully.
                        '''
                    }
                }
            }
        }

        stage('Docker Build') {

            steps {

                dir("${APP_DIR}") {

                    echo "Building Docker image: ${DOCKER_IMAGE}"

                    bat """
                        echo.
                        echo ============================================================
                        echo DOCKER BUILD
                        echo ============================================================
                        echo.

                        docker build ^
                            -t "${DOCKER_IMAGE}" ^
                            -t "${DOCKER_LATEST}" ^
                            .

                        if errorlevel 1 (
                            echo ERROR: Docker build failed.
                            exit /b 1
                        )

                        echo.
                        echo Docker images built successfully.
                    """
                }
            }
        }

        stage('Docker Image Validation') {

            steps {

                bat """
                    echo.
                    echo ============================================================
                    echo DOCKER IMAGE VALIDATION
                    echo ============================================================
                    echo.

                    docker image inspect "${DOCKER_IMAGE}" >nul

                    if errorlevel 1 (
                        echo ERROR: Versioned Docker image was not created.
                        exit /b 1
                    )

                    docker image inspect "${DOCKER_LATEST}" >nul

                    if errorlevel 1 (
                        echo ERROR: Latest Docker image was not created.
                        exit /b 1
                    )

                    echo Docker image validation successful.
                """
            }
        }

        stage('Docker Hub Push') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_CREDENTIAL_ID}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    bat """
                        echo.
                        echo ============================================================
                        echo DOCKER HUB PUSH
                        echo ============================================================
                        echo.

                        echo Logging into Docker Hub...

                        echo %DOCKER_PASSWORD% | docker login ^
                            -u "%DOCKER_USERNAME%" ^
                            --password-stdin

                        if errorlevel 1 (
                            echo ERROR: Docker Hub login failed.
                            exit /b 1
                        )

                        echo.
                        echo Docker Hub login successful.

                        echo.
                        echo Pushing versioned image...

                        docker push "${DOCKER_IMAGE}"

                        if errorlevel 1 (
                            echo ERROR: Versioned image push failed.
                            docker logout
                            exit /b 1
                        )

                        echo.
                        echo Pushing latest image...

                        docker push "${DOCKER_LATEST}"

                        if errorlevel 1 (
                            echo ERROR: Latest image push failed.
                            docker logout
                            exit /b 1
                        )

                        docker logout

                        echo.
                        echo Docker Hub push completed successfully.
                    """
                }
            }
        }

        stage('Deploy to AWS EC2') {

            steps {

                dir("${APP_DIR}") {

                    withCredentials([
                        sshUserPrivateKey(
                            credentialsId: "${SSH_CREDENTIAL_ID}",
                            keyFileVariable: 'SSH_KEY'
                        )
                    ]) {

                        bat """
                            echo.
                            echo ============================================================
                            echo AWS EC2 DEPLOYMENT
                            echo ============================================================
                            echo.

                            echo Preparing SSH key...

                            icacls "%SSH_KEY%" /inheritance:r

                            if errorlevel 1 (
                                echo ERROR: Failed to remove inherited permissions.
                                exit /b 1
                            )

                            icacls "%SSH_KEY%" /grant:r "NT AUTHORITY\\\\SYSTEM:(F)"

                            if errorlevel 1 (
                                echo ERROR: Failed to grant SYSTEM permissions.
                                exit /b 1
                            )

                            icacls "%SSH_KEY%" /grant:r "BUILTIN\\\\Administrators:(F)"

                            if errorlevel 1 (
                                echo ERROR: Failed to grant Administrators permissions.
                                exit /b 1
                            )

                            echo SSH key permissions configured.
                            echo.

                            echo Testing SSH connection to EC2...

                            ssh ^
                                -o StrictHostKeyChecking=no ^
                                -o ConnectTimeout=20 ^
                                -i "%SSH_KEY%" ^
                                "%EC2_USER%@%EC2_IP%" ^
                                "echo SSH connection successful"

                            if errorlevel 1 (
                                echo.
                                echo ERROR: SSH connection to EC2 failed.
                                echo.
                                echo Verify that credential ec2-ssh-key matches
                                echo the AWS EC2 key pair used by %EC2_IP%.
                                exit /b 1
                            )

                            echo.
                            echo SSH connection successful.
                            echo.

                            echo Copying deploy.sh to EC2...

                            scp ^
                                -o StrictHostKeyChecking=no ^
                                -o ConnectTimeout=20 ^
                                -i "%SSH_KEY%" ^
                                "deploy.sh" ^
                                "%EC2_USER%@%EC2_IP%:/home/ubuntu/deploy.sh"

                            if errorlevel 1 (
                                echo ERROR: Failed to copy deploy.sh.
                                exit /b 1
                            )

                            echo.
                            echo deploy.sh copied successfully.
                            echo.

                            echo Converting deploy.sh to Unix LF format on EC2...

                            ssh ^
                                -o StrictHostKeyChecking=no ^
                                -o ConnectTimeout=20 ^
                                -i "%SSH_KEY%" ^
                                "%EC2_USER%@%EC2_IP%" ^
                                "sed -i 's/\\\\r$//' /home/ubuntu/deploy.sh"

                            if errorlevel 1 (
                                echo ERROR: Failed to convert deploy.sh line endings on EC2.
                                exit /b 1
                            )

                            echo.
                            echo deploy.sh converted successfully on EC2.
                            echo.

                            echo Setting execute permission...

                            ssh ^
                                -o StrictHostKeyChecking=no ^
                                -o ConnectTimeout=20 ^
                                -i "%SSH_KEY%" ^
                                "%EC2_USER%@%EC2_IP%" ^
                                "chmod +x /home/ubuntu/deploy.sh"

                            if errorlevel 1 (
                                echo ERROR: Failed to set execute permission.
                                exit /b 1
                            )

                            echo.
                            echo Starting AWS deployment...

                            ssh ^
                                -o StrictHostKeyChecking=no ^
                                -o ConnectTimeout=20 ^
                                -i "%SSH_KEY%" ^
                                "%EC2_USER%@%EC2_IP%" ^
                                "/bin/bash /home/ubuntu/deploy.sh %DOCKER_IMAGE%"

                            if errorlevel 1 (
                                echo ERROR: AWS EC2 deployment failed.
                                exit /b 1
                            )

                            echo.
                            echo ============================================================
                            echo AWS EC2 DEPLOYMENT SUCCESSFUL
                            echo ============================================================
                        """
                    }
                }
            }
        }

        stage('Verify AWS EC2') {

            steps {

                bat """
                    echo.
                    echo ============================================================
                    echo VERIFY AWS EC2
                    echo ============================================================
                    echo.

                    echo Checking application at:
                    echo http://%EC2_IP%

                    powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command ^
                    "$ok=\\$false; for(\\$i=1; \\$i -le 12; \\$i++){ try { \\$r=Invoke-WebRequest -Uri 'http://%EC2_IP%' -UseBasicParsing -TimeoutSec 10; if(\\$r.StatusCode -eq 200){ \\$ok=\\$true; Write-Host 'AWS application is responding.'; break } } catch { Write-Host ('AWS check attempt ' + \\$i + ' failed.'); }; Start-Sleep -Seconds 5 }; if(-not \\$ok){ exit 1 }"

                    if errorlevel 1 (
                        echo ERROR: AWS EC2 application verification failed.
                        exit /b 1
                    )

                    echo.
                    echo AWS EC2 verification successful.
                """
            }
        }

        stage('Deploy to Render') {

            steps {

                withCredentials([
                    string(
                        credentialsId: "${RENDER_DEPLOY_HOOK_CREDENTIAL_ID}",
                        variable: 'RENDER_DEPLOY_HOOK'
                    )
                ]) {

                    bat """
                        echo.
                        echo ============================================================
                        echo RENDER DEPLOYMENT
                        echo ============================================================
                        echo.

                        echo Triggering Render deployment...

                        powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command ^
                        "\\$hook='%RENDER_DEPLOY_HOOK%'; \\$url=\\$hook + '&imgURL=docker.io%%2F%DOCKERHUB_USER%%%2F%IMAGE_NAME%%%3A%BUILD_NUMBER%'; \\$response=Invoke-WebRequest -Uri \\$url -Method Post -UseBasicParsing -TimeoutSec 30; Write-Host ('Render HTTP Status: ' + [int]\\$response.StatusCode); if(([int]\\$response.StatusCode -ne 200) -and ([int]\\$response.StatusCode -ne 202)){ exit 1 }"

                        if errorlevel 1 (
                            echo ERROR: Render deployment trigger failed.
                            exit /b 1
                        )

                        echo.
                        echo Render deployment triggered successfully.
                        echo Docker image:
                        echo %DOCKER_IMAGE%
                    """
                }
            }
        }

        stage('Verify Render') {

            steps {

                bat """
                    echo.
                    echo ============================================================
                    echo VERIFY RENDER
                    echo ============================================================
                    echo.

                    echo Checking:
                    echo %RENDER_URL%

                    powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command ^
                    "$ok=\\$false; for(\\$i=1; \\$i -le 18; \\$i++){ try { \\$r=Invoke-WebRequest -Uri '%RENDER_URL%' -UseBasicParsing -TimeoutSec 15; if(\\$r.StatusCode -eq 200){ \\$ok=\\$true; Write-Host 'Render application is responding.'; break } } catch { Write-Host ('Render check attempt ' + \\$i + ' failed.'); }; Start-Sleep -Seconds 10 }; if(-not \\$ok){ exit 1 }"

                    if errorlevel 1 (
                        echo ERROR: Render application verification failed.
                        exit /b 1
                    )

                    echo.
                    echo Render verification successful.
                """
            }
        }

        stage('Multi-Cloud Status') {

            steps {

                echo ''
                echo '============================================================'
                echo 'MULTI-CLOUD DEPLOYMENT STATUS'
                echo '============================================================'
                echo ''
                echo "AWS EC2   : http://${params.EC2_IP}"
                echo "Render    : ${RENDER_URL}"
                echo "Image     : ${DOCKER_IMAGE}"
                echo ''
                echo 'AWS deployment : SUCCESS'
                echo 'Render deployment : SUCCESS'
                echo ''
                echo 'Multi-cloud deployment completed successfully.'
                echo '============================================================'
            }
        }

        stage('Kubernetes Deployment') {

            when {
                expression {
                    return params.K8S_ENABLED
                }
            }

            steps {

                bat '''
                    echo.
                    echo ============================================================
                    echo KUBERNETES DEPLOYMENT
                    echo ============================================================
                    echo.

                    kubectl version --client

                    if errorlevel 1 (
                        echo ERROR: kubectl is not available.
                        exit /b 1
                    )

                    kubectl cluster-info

                    if errorlevel 1 (
                        echo ERROR: Kubernetes cluster is not reachable.
                        exit /b 1
                    )

                    if exist "%WORKSPACE%\\k8s\\configmap.yaml" (
                        kubectl apply -f "%WORKSPACE%\\k8s\\configmap.yaml"

                        if errorlevel 1 (
                            echo ERROR: ConfigMap deployment failed.
                            exit /b 1
                        )
                    )

                    if exist "%WORKSPACE%\\k8s\\deployment.yaml" (
                        kubectl apply -f "%WORKSPACE%\\k8s\\deployment.yaml"

                        if errorlevel 1 (
                            echo ERROR: Deployment manifest failed.
                            exit /b 1
                        )
                    )

                    if exist "%WORKSPACE%\\k8s\\service.yaml" (
                        kubectl apply -f "%WORKSPACE%\\k8s\\service.yaml"

                        if errorlevel 1 (
                            echo ERROR: Service manifest failed.
                            exit /b 1
                        )
                    )

                    kubectl rollout status deployment/fooddelivery-deployment --timeout=180s

                    if errorlevel 1 (
                        echo ERROR: Kubernetes rollout failed.
                        exit /b 1
                    )

                    echo.
                    echo Kubernetes deployment completed successfully.
                '''
            }
        }
    }

    post {

        always {

            echo ''
            echo 'CI/CD pipeline finished for Build #${BUILD_NUMBER}'

            bat '''
                echo.
                echo Cleaning temporary Docker images...

                docker image prune -f >nul 2>&1

                echo Docker cleanup completed.
            '''
        }

        success {

            echo ''
            echo '============================================================'
            echo 'PIPELINE SUCCESSFUL'
            echo '============================================================'
            echo ''
            echo 'Build Number : ${BUILD_NUMBER}'
            echo 'Docker Image : ${DOCKER_IMAGE}'
            echo 'AWS EC2      : http://${EC2_IP}'
            echo 'Render       : ${RENDER_URL}'
            echo ''
            echo 'Multi-cloud deployment completed successfully.'
            echo '============================================================'
        }

        failure {

            echo ''
            echo '============================================================'
            echo 'PIPELINE FAILED'
            echo '============================================================'
            echo ''
            echo 'Check the failed stage in the Jenkins console output.'
        }
    }
}