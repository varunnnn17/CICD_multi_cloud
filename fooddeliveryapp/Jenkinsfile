pipeline {

    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {

        string(
            name: 'EC2_IP',
            defaultValue: '18.213.199.167',
            description: 'AWS EC2 Elastic IP address'
        )

        string(
            name: 'EC2_USER',
            defaultValue: 'ubuntu',
            description: 'AWS EC2 SSH username'
        )

        booleanParam(
            name: 'SONAR_ENABLED',
            defaultValue: false,
            description: 'Enable SonarQube analysis'
        )

        booleanParam(
            name: 'K8S_ENABLED',
            defaultValue: false,
            description: 'Enable Kubernetes deployment'
        )
    }

    environment {

        DOCKERHUB_USER = 'varun1716'
        IMAGE_NAME = 'food-delivery'

        APP_DIR = 'fooddeliveryapp'
        APP_PORT = '8083'
        AWS_HOST_PORT = '80'

        DOCKER_CREDENTIALS_ID = 'dockercred1'
        EC2_CREDENTIALS_ID = 'ec2-ssh-key'
        SONAR_CREDENTIALS_ID = 'CseSonar'
        RENDER_CREDENTIALS_ID = 'render-deploy-hook'

        RENDER_URL = 'https://food-delivery-render.onrender.com'

        DOCKER_IMAGE = "varun1716/food-delivery:${BUILD_NUMBER}"
        DOCKER_LATEST = 'varun1716/food-delivery:latest'
    }

    stages {

        stage('Environment Validation') {

            steps {

                echo '''
============================================================
MULTI-CLOUD CI/CD PIPELINE
============================================================
'''

                echo "Jenkins Agent       : Windows"
                echo "Application         : Food Delivery Sample"
                echo "Application Dir     : ${APP_DIR}"
                echo "Application Port    : ${APP_PORT}"
                echo "Docker Image        : ${DOCKER_IMAGE}"
                echo "AWS EC2             : ${params.EC2_IP}"
                echo "AWS Host Port       : ${AWS_HOST_PORT}"
                echo "Render URL          : ${RENDER_URL}"
                echo "SonarQube Enabled   : ${params.SONAR_ENABLED}"
                echo "Kubernetes Enabled  : ${params.K8S_ENABLED}"

                bat '''
                    echo.
                    echo Checking required tools...
                    echo.

                    java -version
                    if errorlevel 1 exit /b 1

                    mvnw.cmd --version
                    if errorlevel 1 exit /b 1

                    docker --version
                    if errorlevel 1 exit /b 1

                    ssh -V
                    if errorlevel 1 exit /b 1

                    scp -V
                    if errorlevel 1 exit /b 1

                    curl.exe --version
                    if errorlevel 1 exit /b 1

                    echo.
                    echo Required tools are available.
                '''
            }
        }

        stage('Maven Test') {

            steps {

                dir("${APP_DIR}") {

                    bat '''
                        echo.
                        echo ============================================================
                        echo MAVEN UNIT TESTS
                        echo ============================================================
                        echo.

                        mvnw.cmd clean test

                        if errorlevel 1 (
                            echo Maven tests failed.
                            exit /b 1
                        )

                        echo.
                        echo Maven tests completed successfully.
                    '''
                }
            }
        }

        stage('Maven Package') {

            steps {

                dir("${APP_DIR}") {

                    bat '''
                        echo.
                        echo ============================================================
                        echo MAVEN PACKAGE
                        echo ============================================================
                        echo.

                        mvnw.cmd package -DskipTests

                        if errorlevel 1 (
                            echo Maven package failed.
                            exit /b 1
                        )

                        echo.
                        echo Maven package completed successfully.
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {

            when {
                expression {
                    return params.SONAR_ENABLED
                }
            }

            steps {

                dir("${APP_DIR}") {

                    echo 'Starting SonarQube analysis...'

                    bat '''
                        mvnw.cmd sonar:sonar

                        if errorlevel 1 (
                            echo SonarQube analysis failed.
                            exit /b 1
                        )

                        echo SonarQube analysis completed successfully.
                    '''
                }
            }
        }

        stage('Docker Build') {

            steps {

                dir("${APP_DIR}") {

                    echo "Building Docker image: ${DOCKER_IMAGE}"

                    bat '''
                        echo.
                        echo ============================================================
                        echo DOCKER BUILD
                        echo ============================================================
                        echo.

                        docker build ^
                            -t "%DOCKERHUB_USER%/%IMAGE_NAME%:%BUILD_NUMBER%" ^
                            -t "%DOCKERHUB_USER%/%IMAGE_NAME%:latest" ^
                            .

                        if errorlevel 1 (
                            echo Docker build failed.
                            exit /b 1
                        )

                        echo.
                        echo Docker images built successfully.
                    '''
                }
            }
        }

        stage('Docker Image Validation') {

            steps {

                bat '''
                    echo.
                    echo ============================================================
                    echo DOCKER IMAGE VALIDATION
                    echo ============================================================
                    echo.

                    docker image inspect "%DOCKERHUB_USER%/%IMAGE_NAME%:%BUILD_NUMBER%" >nul

                    if errorlevel 1 (
                        echo ERROR: Versioned Docker image was not created.
                        exit /b 1
                    )

                    docker image inspect "%DOCKERHUB_USER%/%IMAGE_NAME%:latest" >nul

                    if errorlevel 1 (
                        echo ERROR: Latest Docker image was not created.
                        exit /b 1
                    )

                    echo Docker image validation successful.
                    docker images "%DOCKERHUB_USER%/%IMAGE_NAME%"
                '''
            }
        }

        stage('Docker Hub Push') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_CREDENTIALS_ID}",
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    bat '''
                        echo.
                        echo ============================================================
                        echo DOCKER HUB PUSH
                        echo ============================================================
                        echo.

                        echo Logging into Docker Hub...

                        docker login ^
                            -u "%DOCKER_USERNAME%" ^
                            -p "%DOCKER_PASSWORD%"

                        if errorlevel 1 (
                            echo Docker Hub login failed.
                            exit /b 1
                        )

                        echo.
                        echo Pushing versioned image...

                        docker push "%DOCKERHUB_USER%/%IMAGE_NAME%:%BUILD_NUMBER%"

                        if errorlevel 1 (
                            echo Versioned image push failed.
                            docker logout
                            exit /b 1
                        )

                        echo.
                        echo Pushing latest image...

                        docker push "%DOCKERHUB_USER%/%IMAGE_NAME%:latest"

                        if errorlevel 1 (
                            echo Latest image push failed.
                            docker logout
                            exit /b 1
                        )

                        docker logout

                        echo.
                        echo Docker Hub push completed successfully.
                    '''
                }
            }
        }

        stage('Deploy to AWS EC2') {

            steps {

                dir("${APP_DIR}") {

                    withCredentials([
                        sshUserPrivateKey(
                            credentialsId: "${EC2_CREDENTIALS_ID}",
                            keyFileVariable: 'SSH_KEY',
                            usernameVariable: 'SSH_CREDENTIAL_USER'
                        )
                    ]) {

                        bat '''
                            echo.
                            echo ============================================================
                            echo AWS EC2 DEPLOYMENT
                            echo ============================================================
                            echo.

                            echo Preparing SSH key...

                            icacls "%SSH_KEY%" /inheritance:r
                            if errorlevel 1 exit /b 1

                            icacls "%SSH_KEY%" /grant:r "NT AUTHORITY\\SYSTEM:(F)"
                            if errorlevel 1 exit /b 1

                            icacls "%SSH_KEY%" /grant:r "BUILTIN\\Administrators:(F)"
                            if errorlevel 1 exit /b 1

                            echo.
                            echo SSH key permissions configured.

                            echo.
                            echo Converting deploy.sh to Unix LF format...

                            powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$p='deploy.sh'; $c=[System.IO.File]::ReadAllText($p); $c=$c.Replace([Environment]::NewLine, [char]10); $c=$c.Replace([char]13, ''); [System.IO.File]::WriteAllText($p,$c,(New-Object System.Text.UTF8Encoding($false)))"

                            if errorlevel 1 (
                                echo ERROR: Failed to convert deploy.sh line endings.
                                exit /b 1
                            )

                            echo deploy.sh converted successfully.

                            echo.
                            echo Testing SSH connection to EC2...

                            ssh -o StrictHostKeyChecking=no ^
                                -o ConnectTimeout=20 ^
                                -i "%SSH_KEY%" ^
                                "%EC2_USER%@%EC2_IP%" ^
                                "echo SSH connection successful"

                            if errorlevel 1 (
                                echo ERROR: SSH connection to EC2 failed.
                                exit /b 1
                            )

                            echo.
                            echo SSH connection successful.

                            echo.
                            echo Copying deploy.sh to EC2...

                            scp -o StrictHostKeyChecking=no ^
                                -o ConnectTimeout=20 ^
                                -i "%SSH_KEY%" ^
                                "deploy.sh" ^
                                "%EC2_USER%@%EC2_IP%:/home/%EC2_USER%/deploy.sh"

                            if errorlevel 1 (
                                echo ERROR: Failed to copy deploy.sh.
                                exit /b 1
                            )

                            echo deploy.sh copied successfully.

                            echo.
                            echo Starting AWS deployment...

                            ssh -o StrictHostKeyChecking=no ^
                                -o ConnectTimeout=20 ^
                                -i "%SSH_KEY%" ^
                                "%EC2_USER%@%EC2_IP%" ^
                                "chmod +x /home/%EC2_USER%/deploy.sh && /home/%EC2_USER%/deploy.sh %DOCKERHUB_USER%/%IMAGE_NAME%:%BUILD_NUMBER%"

                            if errorlevel 1 (
                                echo ERROR: AWS EC2 deployment failed.
                                exit /b 1
                            )

                            echo.
                            echo AWS EC2 deployment completed successfully.
                        '''
                    }
                }
            }
        }

        stage('Verify AWS EC2') {

            steps {

                bat '''
                    echo.
                    echo ============================================================
                    echo VERIFY AWS APPLICATION
                    echo ============================================================
                    echo.

                    echo Checking:
                    echo http://%EC2_IP%

                    curl.exe -sS -L --max-time 15 -o NUL -w "HTTP_STATUS=%%{http_code}" "http://%EC2_IP%"

                    if errorlevel 1 (
                        echo.
                        echo ERROR: AWS application is not reachable.
                        exit /b 1
                    )

                    echo.
                    echo AWS application is reachable.
                '''
            }
        }

        stage('Deploy to Render') {

            steps {

                withCredentials([
                    string(
                        credentialsId: "${RENDER_CREDENTIALS_ID}",
                        variable: 'RENDER_DEPLOY_HOOK'
                    )
                ]) {

                    bat '''
                        echo.
                        echo ============================================================
                        echo RENDER DEPLOYMENT
                        echo ============================================================
                        echo.

                        echo Triggering Render deployment...

                        curl.exe -sS ^
                            -o render-deploy-response.json ^
                            -w "HTTP_STATUS=%%{http_code}" ^
                            -X POST ^
                            "%RENDER_DEPLOY_HOOK%"

                        if errorlevel 1 (
                            echo ERROR: Failed to contact Render deploy hook.
                            exit /b 1
                        )

                        echo.
                        echo Render deployment trigger sent successfully.

                        if exist render-deploy-response.json (
                            echo.
                            echo Render response:
                            type render-deploy-response.json
                            echo.
                        )
                    '''
                }
            }
        }

        stage('Verify Render') {

            steps {

                bat '''
                    echo.
                    echo ============================================================
                    echo VERIFY RENDER APPLICATION
                    echo ============================================================
                    echo.

                    echo Checking:
                    echo %RENDER_URL%

                    curl.exe -sS -L --max-time 30 -o NUL -w "HTTP_STATUS=%%{http_code}" "%RENDER_URL%"

                    if errorlevel 1 (
                        echo.
                        echo ERROR: Render application is not reachable.
                        exit /b 1
                    )

                    echo.
                    echo Render application is reachable.
                '''
            }
        }

        stage('Multi-Cloud Status') {

            steps {

                echo '''
============================================================
MULTI-CLOUD DEPLOYMENT STATUS
============================================================
'''

                echo "AWS EC2    : http://${params.EC2_IP}"
                echo "Render     : ${RENDER_URL}"
                echo "Docker     : ${DOCKER_IMAGE}"
                echo "Build      : #${BUILD_NUMBER}"

                echo '''
============================================================
AWS + RENDER DEPLOYMENT COMPLETED
============================================================
'''
            }
        }

        stage('Kubernetes Deployment') {

            when {
                expression {
                    return params.K8S_ENABLED
                }
            }

            steps {

                echo '''
Kubernetes deployment is enabled, but the current project
does not automatically deploy to EKS/AKS.

Configure the Kubernetes credentials and manifests before
enabling this stage.
'''
            }
        }
    }

    post {

        always {

            echo "CI/CD pipeline finished for Build #${BUILD_NUMBER}"

            bat '''
                echo.
                echo Cleaning temporary Docker images...

                docker image prune -f >nul 2>&1

                echo Docker cleanup completed.
            '''
        }

        success {

            echo '''
============================================================
PIPELINE SUCCESS
============================================================
'''

            echo "AWS EC2    : http://${params.EC2_IP}"
            echo "Render     : ${RENDER_URL}"
            echo "Docker     : ${DOCKER_IMAGE}"

            echo '''
============================================================
MULTI-CLOUD DEPLOYMENT SUCCESSFUL
============================================================
'''
        }

        failure {

            echo '''
============================================================
PIPELINE FAILED
============================================================
'''

            echo "Check the failed stage in the Jenkins console output."
        }
    }
}