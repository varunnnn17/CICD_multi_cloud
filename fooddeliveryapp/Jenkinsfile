pipeline {

    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {

        string(
            name: 'EC2_IP',
            defaultValue: '18.213.199.167',
            description: 'AWS EC2 Elastic IP address'
        )

        string(
            name: 'EC2_USER',
            defaultValue: 'ubuntu',
            description: 'AWS EC2 SSH username'
        )

        booleanParam(
            name: 'SONAR_ENABLED',
            defaultValue: false,
            description: 'Run SonarQube analysis'
        )

        booleanParam(
            name: 'K8S_ENABLED',
            defaultValue: false,
            description: 'Deploy to Kubernetes'
        )
    }

    environment {

        DOCKERHUB_USER = 'varun1716'
        IMAGE_NAME = 'food-delivery'

        APP_DIR = 'fooddeliveryapp'

        // Spring Boot port inside Docker
        APP_PORT = '8083'

        // Public AWS EC2 HTTP port
        AWS_HOST_PORT = '80'

        // Docker Hub credential
        DOCKER_CRED_ID = 'dockercred1'

        // AWS EC2 SSH credential
        EC2_CRED_ID = 'ec2-ssh-key'

        // Render deploy hook credential
        RENDER_CRED_ID = 'render-deploy-hook'

        // Render application URL
        RENDER_URL = 'https://food-delivery-render.onrender.com'

        SONAR_ENABLED_VALUE = "${params.SONAR_ENABLED}"
        K8S_ENABLED_VALUE = "${params.K8S_ENABLED}"
    }

    stages {

        stage('Environment Validation') {

            steps {

                echo '=========================================================='
                echo 'MULTI-CLOUD CI/CD ENVIRONMENT VALIDATION'
                echo '=========================================================='

                echo "Jenkins Agent       : Windows"
                echo "Application Dir     : ${env.APP_DIR}"
                echo "Application Port    : ${env.APP_PORT}"
                echo "AWS Host Port       : ${env.AWS_HOST_PORT}"
                echo "Docker Image        : ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}"
                echo "AWS EC2 IP          : ${params.EC2_IP}"
                echo "AWS EC2 User        : ${params.EC2_USER}"
                echo "Render URL          : ${env.RENDER_URL}"

                bat '''
                    echo.
                    echo Checking Java...
                    java -version

                    echo.
                    echo Checking Docker...
                    docker --version

                    echo.
                    echo Checking Git...
                    git --version

                    echo.
                    echo Checking SSH...
                    ssh -V

                    echo.
                    echo Checking SCP...
                    where scp

                    echo.
                    echo Checking CURL...
                    where curl.exe

                    if %ERRORLEVEL% NEQ 0 (
                        echo ERROR: curl.exe not found.
                        exit /b 1
                    )

                    echo.
                    echo Environment validation completed successfully.
                '''
            }
        }

        stage('Maven Test') {

            steps {

                dir("${env.APP_DIR}") {

                    echo '=========================================================='
                    echo 'RUNNING MAVEN TESTS'
                    echo '=========================================================='

                    bat '''
                        if not exist mvnw.cmd (
                            echo ERROR: mvnw.cmd not found.
                            exit /b 1
                        )

                        call mvnw.cmd clean test

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Maven tests failed.
                            exit /b 1
                        )

                        echo.
                        echo Maven tests completed successfully.
                    '''
                }
            }
        }

        stage('Maven Package') {

            steps {

                dir("${env.APP_DIR}") {

                    echo '=========================================================='
                    echo 'PACKAGING SPRING BOOT APPLICATION'
                    echo '=========================================================='

                    bat '''
                        call mvnw.cmd clean package -DskipTests=true

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Maven package failed.
                            exit /b 1
                        )

                        echo.
                        echo Generated JAR:
                        dir target\\*.jar
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {

            when {
                expression {
                    return params.SONAR_ENABLED
                }
            }

            steps {

                dir("${env.APP_DIR}") {

                    echo '=========================================================='
                    echo 'RUNNING SONARQUBE ANALYSIS'
                    echo '=========================================================='

                    bat '''
                        call mvnw.cmd sonar:sonar

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: SonarQube analysis failed.
                            exit /b 1
                        )

                        echo.
                        echo SonarQube analysis completed successfully.
                    '''
                }
            }
        }

        stage('Docker Build') {

            steps {

                dir("${env.APP_DIR}") {

                    echo '=========================================================='
                    echo 'BUILDING DOCKER IMAGE'
                    echo '=========================================================='

                    bat """
                        docker build ^
                            -t ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER} ^
                            -t ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:latest .

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker build failed.
                            exit /b 1
                        )

                        echo.
                        echo Docker build completed successfully.

                        echo.
                        echo Created images:
                        docker images ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}
                    """
                }
            }
        }

        stage('Docker Image Validation') {

            steps {

                dir("${env.APP_DIR}") {

                    echo '=========================================================='
                    echo 'VALIDATING DOCKER IMAGE'
                    echo '=========================================================='

                    bat """
                        docker image inspect ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker image validation failed.
                            exit /b 1
                        )

                        echo.
                        echo Docker image validation successful.
                    """
                }
            }
        }

        stage('Docker Hub Push') {

            steps {

                echo '=========================================================='
                echo 'PUSHING DOCKER IMAGE TO DOCKER HUB'
                echo '=========================================================='

                withCredentials([
                    usernamePassword(
                        credentialsId: "${env.DOCKER_CRED_ID}",
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    bat """
                        echo Logging into Docker Hub...

                        echo %DOCKER_PASS% | docker login ^
                            -u %DOCKER_USER% ^
                            --password-stdin

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker Hub login failed.
                            exit /b 1
                        )

                        echo.
                        echo Pushing versioned image:
                        echo ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}

                        docker push ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Versioned Docker image push failed.
                            docker logout
                            exit /b 1
                        )

                        echo.
                        echo Pushing latest image:
                        echo ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:latest

                        docker push ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:latest

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker latest image push failed.
                            docker logout
                            exit /b 1
                        )

                        docker logout

                        echo.
                        echo Docker images pushed successfully.
                    """
                }
            }
        }

        stage('Deploy to AWS EC2') {

            steps {

                echo '=========================================================='
                echo 'DEPLOYING TO AWS EC2'
                echo '=========================================================='

                echo "EC2 IP       : ${params.EC2_IP}"
                echo "EC2 User     : ${params.EC2_USER}"
                echo "Public Port  : ${env.AWS_HOST_PORT}"
                echo "App Port     : ${env.APP_PORT}"
                echo "Docker Image : ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}"

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: "${env.EC2_CRED_ID}",
                        keyFileVariable: 'SSH_KEY_FILE',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {

                    dir("${env.APP_DIR}") {

                        bat """
                            echo.
                            echo ==========================================================
                            echo PREPARING SSH PRIVATE KEY
                            echo ==========================================================

                            set "FIXED_KEY=%WORKSPACE%\\\\ec2-deploy-key.pem"

                            copy /Y "%SSH_KEY_FILE%" "%FIXED_KEY%"

                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: Failed to copy SSH private key.
                                exit /b 1
                            )

                            echo.
                            echo Removing inherited permissions...

                            icacls "%FIXED_KEY%" /inheritance:r

                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: Failed to remove inherited permissions.
                                del /f /q "%FIXED_KEY%" >nul 2>&1
                                exit /b 1
                            )

                            echo.
                            echo Removing BUILTIN Users permissions...

                            icacls "%FIXED_KEY%" /remove:g "BUILTIN\\\\Users"

                            echo.
                            echo Removing Everyone permissions...

                            icacls "%FIXED_KEY%" /remove:g "Everyone"

                            echo.
                            echo Granting LocalSystem full access...

                            icacls "%FIXED_KEY%" /grant:r "NT AUTHORITY\\\\SYSTEM:(F)"

                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: Failed to grant LocalSystem permissions.
                                del /f /q "%FIXED_KEY%" >nul 2>&1
                                exit /b 1
                            )

                            echo.
                            echo Granting Administrators full access...

                            icacls "%FIXED_KEY%" /grant:r "BUILTIN\\\\Administrators:(F)"

                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: Failed to grant Administrators permissions.
                                del /f /q "%FIXED_KEY%" >nul 2>&1
                                exit /b 1
                            )

                            echo.
                            echo Current SSH key permissions:

                            icacls "%FIXED_KEY%"

                            echo.
                            echo ==========================================================
                            echo TESTING SSH CONNECTION
                            echo ==========================================================

                            ssh ^
                                -o StrictHostKeyChecking=no ^
                                -o UserKnownHostsFile=NUL ^
                                -o ConnectTimeout=15 ^
                                -i "%FIXED_KEY%" ^
                                "${params.EC2_USER}@${params.EC2_IP}" ^
                                "echo SSH_CONNECTION_SUCCESS"

                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: SSH connection to EC2 failed.
                                del /f /q "%FIXED_KEY%" >nul 2>&1
                                exit /b 1
                            )

                            echo.
                            echo SSH connection successful.

                            echo.
                            echo ==========================================================
                            echo PREPARING deploy.sh FOR LINUX
                            echo ==========================================================

                            powershell -NoProfile -ExecutionPolicy Bypass -Command ^
                                "\\$path = 'deploy.sh'; \\$content = [System.IO.File]::ReadAllText(\\$path); [System.IO.File]::WriteAllText(\\$path, (\\$content -replace \"`r`n\",\"`n\" -replace \"`r\",\"`n\"), (New-Object System.Text.UTF8Encoding(\\$false)))"

                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: Failed to convert deploy.sh to Linux line endings.
                                del /f /q "%FIXED_KEY%" >nul 2>&1
                                exit /b 1
                            )

                            echo deploy.sh converted to Linux line endings successfully.

                            echo.
                            echo ==========================================================
                            echo COPYING deploy.sh TO EC2
                            echo ==========================================================

                            scp ^
                                -o StrictHostKeyChecking=no ^
                                -o UserKnownHostsFile=NUL ^
                                -o ConnectTimeout=15 ^
                                -i "%FIXED_KEY%" ^
                                "deploy.sh" ^
                                "${params.EC2_USER}@${params.EC2_IP}:/home/${params.EC2_USER}/deploy.sh"

                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: SCP failed.
                                del /f /q "%FIXED_KEY%" >nul 2>&1
                                exit /b 1
                            )

                            echo.
                            echo deploy.sh copied successfully.

                            echo.
                            echo ==========================================================
                            echo RUNNING DEPLOYMENT ON EC2
                            echo ==========================================================

                            ssh ^
                                -o StrictHostKeyChecking=no ^
                                -o UserKnownHostsFile=NUL ^
                                -o ConnectTimeout=15 ^
                                -i "%FIXED_KEY%" ^
                                "${params.EC2_USER}@${params.EC2_IP}" ^
                                "chmod +x /home/${params.EC2_USER}/deploy.sh && /home/${params.EC2_USER}/deploy.sh ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}"

                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: EC2 deployment failed.
                                del /f /q "%FIXED_KEY%" >nul 2>&1
                                exit /b 1
                            )

                            echo.
                            echo ==========================================================
                            echo EC2 DEPLOYMENT SUCCESSFUL
                            echo ==========================================================

                            echo Application URL:
                            echo http://${params.EC2_IP}

                            del /f /q "%FIXED_KEY%" >nul 2>&1
                        """
                    }
                }
            }
        }

        stage('Verify AWS EC2') {

            steps {

                echo '=========================================================='
                echo 'VERIFYING AWS EC2 APPLICATION'
                echo '=========================================================='

                echo "AWS URL: http://${params.EC2_IP}"

                bat """
                    set "AWS_URL=http://${params.EC2_IP}"

                    echo Waiting for AWS application...

                    timeout /t 10 /nobreak >nul

                    set "AWS_OK=0"

                    for /L %%N in (1,1,12) do (
                        echo AWS verification attempt %%N of 12...

                        curl.exe -fsS --max-time 20 -o NUL "%AWS_URL%"

                        if %ERRORLEVEL% EQU 0 (
                            set "AWS_OK=1"
                            goto AWS_VERIFY_SUCCESS
                        )

                        timeout /t 5 /nobreak >nul
                    )

                    :AWS_VERIFY_SUCCESS

                    if "%AWS_OK%"=="1" (
                        echo.
                        echo AWS APPLICATION IS REACHABLE.
                        echo AWS URL: %AWS_URL%
                        goto AWS_VERIFY_DONE
                    )

                    echo.
                    echo ERROR: AWS application could not be reached.
                    exit /b 1

                    :AWS_VERIFY_DONE
                """
            }
        }

        stage('Deploy to Render') {

            options {
                timeout(time: 10, unit: 'MINUTES')
            }

            steps {

                echo '=========================================================='
                echo 'DEPLOYING TO RENDER'
                echo '=========================================================='

                echo "Render Service : food-delivery-render"
                echo "Render URL     : ${env.RENDER_URL}"
                echo "Docker Image   : ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}"

                withCredentials([
                    string(
                        credentialsId: "${env.RENDER_CRED_ID}",
                        variable: 'RENDER_DEPLOY_HOOK'
                    )
                ]) {

                    bat """
                        echo.
                        echo Triggering Render deployment...

                        del /f /q render-deploy-response.json >nul 2>&1

                        for /f "delims=" %%R in ('curl.exe -sS -o render-deploy-response.json -w "%%{http_code}" -X POST "%RENDER_DEPLOY_HOOK%&imgURL=docker.io%%2F${env.DOCKERHUB_USER}%%2F${env.IMAGE_NAME}%%3A${env.BUILD_NUMBER}"') do set "RENDER_STATUS=%%R"

                        echo Render HTTP response: %RENDER_STATUS%

                        if "%RENDER_STATUS%"=="200" goto RENDER_TRIGGER_SUCCESS
                        if "%RENDER_STATUS%"=="202" goto RENDER_TRIGGER_SUCCESS

                        echo.
                        echo ERROR: Render deployment trigger failed.
                        echo Render response:
                        type render-deploy-response.json
                        exit /b 1

                        :RENDER_TRIGGER_SUCCESS

                        echo.
                        echo Render deployment triggered successfully.

                        echo.
                        echo Render response:
                        type render-deploy-response.json

                        del /f /q render-deploy-response.json >nul 2>&1
                    """
                }
            }
        }

        stage('Verify Render') {

            options {
                timeout(time: 5, unit: 'MINUTES')
            }

            steps {

                echo '=========================================================='
                echo 'VERIFYING RENDER APPLICATION'
                echo '=========================================================='

                echo "Render URL: ${env.RENDER_URL}"

                bat """
                    set "RENDER_OK=0"

                    echo Waiting for Render deployment to become available...

                    timeout /t 20 /nobreak >nul

                    for /L %%N in (1,1,18) do (
                        echo Render verification attempt %%N of 18...

                        curl.exe -fsS --max-time 30 -o NUL "${env.RENDER_URL}/"

                        if %ERRORLEVEL% EQU 0 (
                            set "RENDER_OK=1"
                            goto RENDER_VERIFY_SUCCESS
                        )

                        timeout /t 10 /nobreak >nul
                    )

                    :RENDER_VERIFY_SUCCESS

                    if "%RENDER_OK%"=="1" (
                        echo.
                        echo RENDER APPLICATION IS REACHABLE.
                        echo Render URL: ${env.RENDER_URL}
                        goto RENDER_VERIFY_DONE
                    )

                    echo.
                    echo ERROR: Render application could not be reached.
                    exit /b 1

                    :RENDER_VERIFY_DONE
                """
            }
        }

        stage('Multi-Cloud Status') {

            steps {

                echo '=========================================================='
                echo 'MULTI-CLOUD DEPLOYMENT STATUS'
                echo '=========================================================='

                echo "=========================================================="
                echo "AWS EC2"
                echo "=========================================================="
                echo "Status : HEALTHY"
                echo "IP     : ${params.EC2_IP}"
                echo "URL    : http://${params.EC2_IP}"

                echo "=========================================================="
                echo "RENDER"
                echo "=========================================================="
                echo "Status : HEALTHY"
                echo "URL    : ${env.RENDER_URL}"

                echo "=========================================================="
                echo "MULTI-CLOUD DEPLOYMENT SUCCESSFUL"
                echo "=========================================================="
            }
        }

        stage('Kubernetes Deploy') {

            when {
                expression {
                    return params.K8S_ENABLED
                }
            }

            steps {

                echo '=========================================================='
                echo 'KUBERNETES DEPLOYMENT'
                echo '=========================================================='

                echo 'Kubernetes deployment is enabled.'
                echo 'Add your Kubernetes deployment commands here.'
            }
        }
    }

    post {

        always {

            echo "CI/CD Pipeline finished for Build #${env.BUILD_NUMBER}"

            echo '=========================================================='
            echo 'CLEANING UNUSED LOCAL DOCKER IMAGES'
            echo '=========================================================='

            bat '''
                docker image prune -f
            '''
        }

        success {

            echo '=========================================================='
            echo 'MULTI-CLOUD PIPELINE SUCCESSFUL'
            echo '=========================================================='

            echo "AWS Application:"
            echo "http://${params.EC2_IP}"

            echo "Render Application:"
            echo "${env.RENDER_URL}"

            echo '=========================================================='
        }

        failure {

            echo '=========================================================='
            echo 'MULTI-CLOUD PIPELINE FAILED'
            echo '=========================================================='

            echo 'Check the failed stage above.'

            echo '=========================================================='
        }
    }
}