pipeline {

    agent any

    options {
        timestamps()
        skipDefaultCheckout(false)
        disableConcurrentBuilds()
    }

    parameters {

        string(
            name: 'EC2_IP',
            defaultValue: '18.213.199.167',
            description: 'AWS EC2 Elastic IP address'
        )

        string(
            name: 'EC2_USER',
            defaultValue: 'ubuntu',
            description: 'AWS EC2 SSH username'
        )

        string(
            name: 'DOCKERHUB_USER',
            defaultValue: 'varun1716',
            description: 'Docker Hub username'
        )

        booleanParam(
            name: 'SONAR_ENABLED',
            defaultValue: false,
            description: 'Enable SonarQube analysis'
        )

        booleanParam(
            name: 'K8S_ENABLED',
            defaultValue: false,
            description: 'Enable Kubernetes deployment'
        )
    }

    environment {

        APP_DIR = 'fooddeliveryapp'

        APP_PORT = '8083'

        AWS_HOST_PORT = '80'

        IMAGE_NAME = 'food-delivery'

        DOCKER_CREDENTIAL_ID = 'dockercred1'

        SSH_CREDENTIAL_ID = 'ec2-ssh-key'

        RENDER_DEPLOY_HOOK_CREDENTIAL_ID = 'render-deploy-hook'

        RENDER_URL = 'https://food-delivery-render.onrender.com'
    }

    stages {

        stage('Environment Validation') {

            steps {

                echo ''
                echo '============================================================'
                echo 'MULTI-CLOUD CI/CD PIPELINE'
                echo '============================================================'
                echo ''
                echo "Jenkins Agent       : Windows"
                echo "Application         : Food Delivery Sample"
                echo "Application Dir     : ${APP_DIR}"
                echo "Application Port    : ${APP_PORT}"
                echo "Docker Image        : ${params.DOCKERHUB_USER}/${IMAGE_NAME}:${BUILD_NUMBER}"
                echo "AWS EC2             : ${params.EC2_IP}"
                echo "AWS Host Port       : ${AWS_HOST_PORT}"
                echo "Render URL          : ${RENDER_URL}"
                echo "SonarQube Enabled   : ${params.SONAR_ENABLED}"
                echo "Kubernetes Enabled  : ${params.K8S_ENABLED}"
                echo ''

                bat '''
                    echo.
                    echo Checking Java...
                    java -version

                    if errorlevel 1 (
                        echo ERROR: Java is not available.
                        exit /b 1
                    )

                    echo.
                    echo Checking Maven Wrapper...
                    cd /d "%WORKSPACE%\\fooddeliveryapp"

                    if not exist "mvnw.cmd" (
                        echo ERROR: mvnw.cmd was not found.
                        exit /b 1
                    )

                    mvnw.cmd --version

                    if errorlevel 1 (
                        echo ERROR: Maven Wrapper is not working.
                        exit /b 1
                    )

                    echo.
                    echo Checking Docker...
                    docker --version

                    if errorlevel 1 (
                        echo ERROR: Docker is not available.
                        exit /b 1
                    )

                    echo.
                    echo Checking Git...
                    git --version

                    if errorlevel 1 (
                        echo ERROR: Git is not available.
                        exit /b 1
                    )

                    echo.
                    echo Checking SSH...
                    ssh -V

                    if errorlevel 1 (
                        echo ERROR: SSH is not available.
                        exit /b 1
                    )

                    echo.
                    echo Checking SCP...
                    where scp

                    if errorlevel 1 (
                        echo ERROR: SCP is not available.
                        exit /b 1
                    )

                    echo.
                    echo Checking curl...
                    curl.exe --version

                    if errorlevel 1 (
                        echo ERROR: curl is not available.
                        exit /b 1
                    )

                    echo.
                    echo Environment validation completed successfully.
                '''
            }
        }

        stage('Maven Test') {

            steps {

                dir("${APP_DIR}") {

                    bat '''
                        echo.
                        echo ============================================================
                        echo MAVEN UNIT TESTS
                        echo ============================================================
                        echo.

                        mvnw.cmd clean test

                        if errorlevel 1 (
                            echo ERROR: Maven tests failed.
                            exit /b 1
                        )

                        echo.
                        echo Maven tests completed successfully.
                    '''
                }
            }
        }

        stage('Maven Package') {

            steps {

                dir("${APP_DIR}") {

                    bat '''
                        echo.
                        echo ============================================================
                        echo MAVEN PACKAGE
                        echo ============================================================
                        echo.

                        mvnw.cmd package -DskipTests

                        if errorlevel 1 (
                            echo ERROR: Maven package failed.
                            exit /b 1
                        )

                        echo.
                        echo Maven package completed successfully.
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {

            when {
                expression {
                    return params.SONAR_ENABLED
                }
            }

            steps {

                dir("${APP_DIR}") {

                    withCredentials([
                        string(
                            credentialsId: 'CseSonar',
                            variable: 'SONAR_TOKEN'
                        )
                    ]) {

                        bat '''
                            echo.
                            echo ============================================================
                            echo SONARQUBE ANALYSIS
                            echo ============================================================
                            echo.

                            mvnw.cmd sonar:sonar -Dsonar.token=%SONAR_TOKEN%

                            if errorlevel 1 (
                                echo ERROR: SonarQube analysis failed.
                                exit /b 1
                            )

                            echo.
                            echo SonarQube analysis completed successfully.
                        '''
                    }
                }
            }
        }

        stage('Docker Build') {

            steps {

                dir("${APP_DIR}") {

                    bat '''
                        echo.
                        echo ============================================================
                        echo DOCKER BUILD
                        echo ============================================================
                        echo.

                        docker build ^
                            -t "%DOCKERHUB_USER%/%IMAGE_NAME%:%BUILD_NUMBER%" ^
                            -t "%DOCKERHUB_USER%/%IMAGE_NAME%:latest" ^
                            .

                        if errorlevel 1 (
                            echo ERROR: Docker build failed.
                            exit /b 1
                        )

                        echo.
                        echo Docker images built successfully.
                    '''
                }
            }
        }

        stage('Docker Image Validation') {

            steps {

                dir("${APP_DIR}") {

                    bat '''
                        echo.
                        echo ============================================================
                        echo DOCKER IMAGE VALIDATION
                        echo ============================================================
                        echo.

                        docker image inspect "%DOCKERHUB_USER%/%IMAGE_NAME%:%BUILD_NUMBER%" >nul

                        if errorlevel 1 (
                            echo ERROR: Versioned Docker image was not created.
                            exit /b 1
                        )

                        docker image inspect "%DOCKERHUB_USER%/%IMAGE_NAME%:latest" >nul

                        if errorlevel 1 (
                            echo ERROR: Latest Docker image was not created.
                            exit /b 1
                        )

                        echo.
                        echo Docker image validation successful.
                    '''
                }
            }
        }

        stage('Docker Hub Push') {

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockercred1',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {

                    bat '''
                        echo.
                        echo ============================================================
                        echo DOCKER HUB PUSH
                        echo ============================================================
                        echo.

                        echo Logging into Docker Hub...

                        echo %DOCKER_PASSWORD% | docker login ^
                            -u "%DOCKER_USERNAME%" ^
                            --password-stdin

                        if errorlevel 1 (
                            echo ERROR: Docker Hub login failed.
                            exit /b 1
                        )

                        echo.
                        echo Docker Hub login successful.

                        echo.
                        echo Pushing versioned image...

                        docker push "%DOCKERHUB_USER%/%IMAGE_NAME%:%BUILD_NUMBER%"

                        if errorlevel 1 (
                            echo ERROR: Versioned Docker image push failed.
                            docker logout
                            exit /b 1
                        )

                        echo.
                        echo Pushing latest image...

                        docker push "%DOCKERHUB_USER%/%IMAGE_NAME%:latest"

                        if errorlevel 1 (
                            echo ERROR: Latest Docker image push failed.
                            docker logout
                            exit /b 1
                        )

                        docker logout

                        echo.
                        echo Docker Hub push completed successfully.
                    '''
                }
            }
        }

        stage('Deploy to AWS EC2') {

            steps {

                dir("${APP_DIR}") {

                    withCredentials([
                        sshUserPrivateKey(
                            credentialsId: 'ec2-ssh-key',
                            keyFileVariable: 'SSH_KEY'
                        )
                    ]) {

                        bat '''
                            echo.
                            echo ============================================================
                            echo AWS EC2 DEPLOYMENT
                            echo ============================================================
                            echo.

                            echo Preparing SSH key permissions...

                            icacls "%SSH_KEY%" /inheritance:r

                            if errorlevel 1 (
                                echo ERROR: Failed to remove inherited permissions.
                                exit /b 1
                            )

                            icacls "%SSH_KEY%" /grant:r "NT AUTHORITY\\SYSTEM:(F)"

                            if errorlevel 1 (
                                echo ERROR: Failed to grant SYSTEM permissions.
                                exit /b 1
                            )

                            icacls "%SSH_KEY%" /grant:r "BUILTIN\\Administrators:(F)"

                            if errorlevel 1 (
                                echo ERROR: Failed to grant Administrators permissions.
                                exit /b 1
                            )

                            echo.
                            echo SSH key permissions configured.

                            echo.
                            echo Testing SSH connection to EC2...

                            ssh ^
                                -o StrictHostKeyChecking=no ^
                                -o ConnectTimeout=20 ^
                                -i "%SSH_KEY%" ^
                                "%EC2_USER%@%EC2_IP%" ^
                                "echo SSH connection successful"

                            if errorlevel 1 (
                                echo.
                                echo ERROR: SSH connection to EC2 failed.
                                exit /b 1
                            )

                            echo.
                            echo SSH connection successful.

                            echo.
                            echo Copying deploy.sh to EC2...

                            scp ^
                                -o StrictHostKeyChecking=no ^
                                -o ConnectTimeout=20 ^
                                -i "%SSH_KEY%" ^
                                "deploy.sh" ^
                                "%EC2_USER%@%EC2_IP%:/home/ubuntu/deploy.sh"

                            if errorlevel 1 (
                                echo ERROR: Failed to copy deploy.sh.
                                exit /b 1
                            )

                            echo.
                            echo deploy.sh copied successfully.

                            echo.
                            echo Removing Windows CR characters from deploy.sh on EC2...

                            ssh ^
                                -o StrictHostKeyChecking=no ^
                                -o ConnectTimeout=20 ^
                                -i "%SSH_KEY%" ^
                                "%EC2_USER%@%EC2_IP%" ^
                                "sed -i 's/\\r$//' /home/ubuntu/deploy.sh"

                            if errorlevel 1 (
                                echo ERROR: Failed to convert deploy.sh to Unix line endings.
                                exit /b 1
                            )

                            echo.
                            echo Unix line-ending conversion completed.

                            echo.
                            echo Setting execute permission...

                            ssh ^
                                -o StrictHostKeyChecking=no ^
                                -o ConnectTimeout=20 ^
                                -i "%SSH_KEY%" ^
                                "%EC2_USER%@%EC2_IP%" ^
                                "chmod +x /home/ubuntu/deploy.sh"

                            if errorlevel 1 (
                                echo ERROR: Failed to set execute permission.
                                exit /b 1
                            )

                            echo.
                            echo Starting AWS deployment...

                            ssh ^
                                -o StrictHostKeyChecking=no ^
                                -o ConnectTimeout=20 ^
                                -i "%SSH_KEY%" ^
                                "%EC2_USER%@%EC2_IP%" ^
                                "/bin/bash /home/ubuntu/deploy.sh %DOCKERHUB_USER%/%IMAGE_NAME%:%BUILD_NUMBER%"

                            if errorlevel 1 (
                                echo.
                                echo ERROR: AWS EC2 deployment failed.
                                exit /b 1
                            )

                            echo.
                            echo ============================================================
                            echo AWS EC2 DEPLOYMENT SUCCESSFUL
                            echo ============================================================
                        '''
                    }
                }
            }
        }

        stage('Verify AWS EC2') {

            steps {

                bat '''
                    echo.
                    echo ============================================================
                    echo VERIFY AWS EC2
                    echo ============================================================
                    echo.

                    echo Checking:
                    echo http://%EC2_IP%

                    curl.exe ^
                        --fail ^
                        --silent ^
                        --show-error ^
                        --max-time 15 ^
                        --retry 12 ^
                        --retry-delay 5 ^
                        --retry-all-errors ^
                        "http://%EC2_IP/"

                    if errorlevel 1 (
                        echo.
                        echo ERROR: AWS EC2 application verification failed.
                        exit /b 1
                    )

                    echo.
                    echo AWS EC2 application is responding successfully.
                '''
            }
        }

        stage('Deploy to Render') {

            steps {

                withCredentials([
                    string(
                        credentialsId: 'render-deploy-hook',
                        variable: 'RENDER_DEPLOY_HOOK'
                    )
                ]) {

                    bat '''
                        echo.
                        echo ============================================================
                        echo RENDER DEPLOYMENT
                        echo ============================================================
                        echo.

                        echo Triggering Render deployment...

                        curl.exe ^
                            --fail ^
                            --silent ^
                            --show-error ^
                            --max-time 60 ^
                            -X POST ^
                            "%RENDER_DEPLOY_HOOK%"

                        if errorlevel 1 (
                            echo.
                            echo ERROR: Render deployment trigger failed.
                            exit /b 1
                        )

                        echo.
                        echo Render deployment triggered successfully.
                        echo.
                        echo Render URL:
                        echo %RENDER_URL%
                    '''
                }
            }
        }

        stage('Verify Render') {

            steps {

                bat '''
                    echo.
                    echo ============================================================
                    echo VERIFY RENDER
                    echo ============================================================
                    echo.

                    echo Checking:
                    echo %RENDER_URL%

                    curl.exe ^
                        --fail ^
                        --silent ^
                        --show-error ^
                        --max-time 30 ^
                        --retry 18 ^
                        --retry-delay 10 ^
                        --retry-all-errors ^
                        "%RENDER_URL%/"

                    if errorlevel 1 (
                        echo.
                        echo ERROR: Render application verification failed.
                        exit /b 1
                    )

                    echo.
                    echo Render application is responding successfully.
                '''
            }
        }

        stage('Multi-Cloud Status') {

            steps {

                echo ''
                echo '============================================================'
                echo 'MULTI-CLOUD DEPLOYMENT STATUS'
                echo '============================================================'
                echo ''
                echo "AWS EC2        : http://${params.EC2_IP}"
                echo "Render         : ${RENDER_URL}"
                echo "Docker Image   : ${params.DOCKERHUB_USER}/${IMAGE_NAME}:${BUILD_NUMBER}"
                echo ''
                echo 'AWS Deployment    : SUCCESS'
                echo 'Render Deployment : SUCCESS'
                echo ''
                echo 'Multi-cloud deployment completed successfully.'
                echo '============================================================'
            }
        }

        stage('Kubernetes Deployment') {

            when {
                expression {
                    return params.K8S_ENABLED
                }
            }

            steps {

                bat '''
                    echo.
                    echo ============================================================
                    echo KUBERNETES DEPLOYMENT
                    echo ============================================================
                    echo.

                    kubectl version --client

                    if errorlevel 1 (
                        echo ERROR: kubectl is not available.
                        exit /b 1
                    )

                    echo.
                    echo Checking Kubernetes cluster...

                    kubectl cluster-info

                    if errorlevel 1 (
                        echo ERROR: Kubernetes cluster is not reachable.
                        exit /b 1
                    )

                    echo.
                    echo Applying Kubernetes manifests...

                    if exist "%WORKSPACE%\\k8s\\configmap.yaml" (
                        kubectl apply -f "%WORKSPACE%\\k8s\\configmap.yaml"

                        if errorlevel 1 (
                            echo ERROR: ConfigMap deployment failed.
                            exit /b 1
                        )
                    )

                    if exist "%WORKSPACE%\\k8s\\deployment.yaml" (
                        kubectl apply -f "%WORKSPACE%\\k8s\\deployment.yaml"

                        if errorlevel 1 (
                            echo ERROR: Deployment manifest failed.
                            exit /b 1
                        )
                    )

                    if exist "%WORKSPACE%\\k8s\\service.yaml" (
                        kubectl apply -f "%WORKSPACE%\\k8s\\service.yaml"

                        if errorlevel 1 (
                            echo ERROR: Service manifest failed.
                            exit /b 1
                        )
                    )

                    echo.
                    echo Waiting for Kubernetes rollout...

                    kubectl rollout status deployment/fooddelivery-deployment --timeout=180s

                    if errorlevel 1 (
                        echo ERROR: Kubernetes rollout failed.
                        exit /b 1
                    )

                    echo.
                    echo Kubernetes deployment completed successfully.
                '''
            }
        }
    }

    post {

        always {

            echo ''
            echo "CI/CD pipeline finished for Build #${BUILD_NUMBER}"

            bat '''
                echo.
                echo Cleaning temporary Docker images...

                docker image prune -f >nul 2>&1

                echo Docker cleanup completed.
            '''
        }

        success {

            echo ''
            echo '============================================================'
            echo 'PIPELINE SUCCESSFUL'
            echo '============================================================'
            echo ''
            echo "Build Number : ${BUILD_NUMBER}"
            echo "Docker Image : ${params.DOCKERHUB_USER}/${IMAGE_NAME}:${BUILD_NUMBER}"
            echo "AWS EC2      : http://${params.EC2_IP}"
            echo "Render       : ${RENDER_URL}"
            echo ''
            echo 'Multi-cloud deployment completed successfully.'
            echo '============================================================'
        }

        failure {

            echo ''
            echo '============================================================'
            echo 'PIPELINE FAILED'
            echo '============================================================'
            echo ''
            echo 'Check the failed stage in the Jenkins console output.'
        }
    }
}