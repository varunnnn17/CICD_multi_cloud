pipeline {

    agent any

    parameters {

        string(
            name: 'EC2_IP',
            defaultValue: '100.62.122.237',
            description: 'AWS EC2 public IP address'
        )

        string(
            name: 'EC2_USER',
            defaultValue: 'ubuntu',
            description: 'AWS EC2 SSH username'
        )

        booleanParam(
            name: 'SONAR_ENABLED',
            defaultValue: false,
            description: 'Run SonarQube analysis'
        )

        booleanParam(
            name: 'K8S_ENABLED',
            defaultValue: false,
            description: 'Deploy to Kubernetes'
        )
    }

    environment {

        // ============================================================
        // Application configuration
        // ============================================================

        DOCKERHUB_USER = 'varun1716'
        IMAGE_NAME     = 'food-delivery'

        APP_DIR  = 'fooddeliveryapp'
        APP_PORT = '8083'

        // ============================================================
        // Jenkins credentials
        // ============================================================

        DOCKER_CRED_ID = 'dockercred1'
        EC2_CRED_ID    = 'ec2-ssh-key'

        // ============================================================
        // Deployment flags
        // ============================================================

        SONAR_ENABLED_VALUE = "${params.SONAR_ENABLED}"
        K8S_ENABLED_VALUE   = "${params.K8S_ENABLED}"
    }

    stages {

        // ============================================================
        // 1. ENVIRONMENT VALIDATION
        // ============================================================

        stage('Environment Validation') {

            steps {

                echo '=========================================================='
                echo 'CI/CD ENVIRONMENT VALIDATION'
                echo '=========================================================='

                echo "Jenkins Agent       : Windows"
                echo "Application Dir     : ${env.APP_DIR}"
                echo "Application Port    : ${env.APP_PORT}"
                echo "Docker Image        : ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}"
                echo "EC2 Host            : ${params.EC2_IP}"
                echo "EC2 User            : ${params.EC2_USER}"

                bat '''
                    echo.
                    echo Checking Java...
                    java -version

                    echo.
                    echo Checking Docker...
                    docker --version

                    echo.
                    echo Checking Git...
                    git --version

                    echo.
                    echo Checking SSH...
                    ssh -V

                    echo.
                    echo Checking SCP...
                    where scp
                '''
            }
        }

        // ============================================================
        // 2. MAVEN TEST
        // ============================================================

        stage('Maven Test') {

            steps {

                dir("${env.APP_DIR}") {

                    echo '=========================================================='
                    echo 'RUNNING MAVEN TESTS'
                    echo '=========================================================='

                    bat '''
                        if not exist mvnw.cmd (
                            echo ERROR: mvnw.cmd not found.
                            exit /b 1
                        )

                        call mvnw.cmd clean test

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Maven tests failed.
                            exit /b 1
                        )

                        echo.
                        echo Maven tests completed successfully.
                    '''
                }
            }
        }

        // ============================================================
        // 3. MAVEN PACKAGE
        // ============================================================

        stage('Maven Package') {

            steps {

                dir("${env.APP_DIR}") {

                    echo '=========================================================='
                    echo 'PACKAGING SPRING BOOT APPLICATION'
                    echo '=========================================================='

                    bat '''
                        call mvnw.cmd clean package -DskipTests=true

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Maven package failed.
                            exit /b 1
                        )

                        echo.
                        echo Generated JAR:
                        dir target\\*.jar
                    '''
                }
            }
        }

        // ============================================================
        // 4. OPTIONAL SONARQUBE
        // ============================================================

        stage('SonarQube Analysis') {

            when {
                expression {
                    return params.SONAR_ENABLED == true
                }
            }

            steps {

                dir("${env.APP_DIR}") {

                    echo '=========================================================='
                    echo 'RUNNING SONARQUBE ANALYSIS'
                    echo '=========================================================='

                    script {

                        withSonarQubeEnv('sonarqube') {

                            bat '''
                                call mvnw.cmd sonar:sonar

                                if %ERRORLEVEL% NEQ 0 (
                                    echo ERROR: SonarQube analysis failed.
                                    exit /b 1
                                )

                                echo SonarQube analysis completed successfully.
                            '''
                        }
                    }
                }
            }
        }

        // ============================================================
        // 5. DOCKER BUILD
        // ============================================================

        stage('Docker Build') {

            steps {

                dir("${env.APP_DIR}") {

                    echo '=========================================================='
                    echo 'BUILDING DOCKER IMAGE'
                    echo '=========================================================='

                    bat """
                        docker build ^
                            -t ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER} ^
                            -t ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:latest .

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker build failed.
                            exit /b 1
                        )

                        echo.
                        echo Docker build completed successfully.
                    """
                }
            }
        }

        // ============================================================
        // 6. DOCKER IMAGE VALIDATION
        // ============================================================

        stage('Docker Image Validation') {

            steps {

                dir("${env.APP_DIR}") {

                    echo '=========================================================='
                    echo 'VALIDATING DOCKER IMAGE'
                    echo '=========================================================='

                    bat """
                        docker image inspect ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker image validation failed.
                            exit /b 1
                        )

                        echo.
                        echo Docker image validation successful.
                    """
                }
            }
        }

        // ============================================================
        // 7. DOCKER HUB PUSH
        // ============================================================

        stage('Docker Hub Push') {

            steps {

                echo '=========================================================='
                echo 'PUSHING DOCKER IMAGE TO DOCKER HUB'
                echo '=========================================================='

                withCredentials([
                    usernamePassword(
                        credentialsId: "${env.DOCKER_CRED_ID}",
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    bat """
                        echo Logging into Docker Hub...

                        echo %DOCKER_PASS% | docker login ^
                            -u %DOCKER_USER% ^
                            --password-stdin

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker Hub login failed.
                            exit /b 1
                        )

                        echo.
                        echo ==========================================================
                        echo Pushing build image:
                        echo ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}
                        echo ==========================================================

                        docker push ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker build image push failed.
                            docker logout
                            exit /b 1
                        )

                        echo.
                        echo ==========================================================
                        echo Pushing latest image:
                        echo ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:latest
                        echo ==========================================================

                        docker push ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:latest

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker latest image push failed.
                            docker logout
                            exit /b 1
                        )

                        echo.
                        echo ==========================================================
                        echo Docker images pushed successfully.
                        echo ==========================================================

                        docker logout

                        exit /b 0
                    """
                }
            }
        }

        // ============================================================
        // 8. DEPLOY TO AWS EC2
        // ============================================================

        stage('Deploy to AWS EC2') {

            steps {

                echo '=========================================================='
                echo 'DEPLOYING TO AWS EC2'
                echo '=========================================================='

                echo "EC2 IP       : ${params.EC2_IP}"
                echo "EC2 User     : ${params.EC2_USER}"
                echo "Application  : ${env.APP_PORT}"
                echo "Docker Image : ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}"

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: "${env.EC2_CRED_ID}",
                        keyFileVariable: 'SSH_KEY_FILE',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {

                    dir("${env.APP_DIR}") {

                        // --------------------------------------------------------
                        // STEP 1:
                        // Prepare SSH key and deploy.sh using PowerShell.
                        //
                        // IMPORTANT:
                        // PowerShell is NOT used to execute ssh.exe.
                        // The actual SSH/SCP commands below are executed with BAT.
                        // --------------------------------------------------------

                        powershell '''
                            $ErrorActionPreference = "Stop"

                            Write-Host "=========================================================="
                            Write-Host "PREPARING EC2 DEPLOYMENT FILES"
                            Write-Host "=========================================================="

                            # ----------------------------------------------------
                            # Jenkins-provided SSH private key
                            # ----------------------------------------------------

                            $sourceKey = $env:SSH_KEY_FILE

                            if ([string]::IsNullOrWhiteSpace($sourceKey)) {
                                throw "SSH_KEY_FILE was not provided by Jenkins."
                            }

                            if (-not (Test-Path $sourceKey)) {
                                throw "SSH private key was not found: $sourceKey"
                            }

                            # Fixed key path inside the Jenkins workspace.
                            $fixedKey = Join-Path (Get-Location) "ec2-deploy-key.pem"

                            Write-Host "Copying SSH private key..."

                            Copy-Item `
                                -Path $sourceKey `
                                -Destination $fixedKey `
                                -Force

                            # ----------------------------------------------------
                            # Fix Windows permissions for OpenSSH.
                            #
                            # Jenkins runs as LocalSystem.
                            # ----------------------------------------------------

                            Write-Host "Removing inherited permissions..."

                            icacls $fixedKey /inheritance:r | Out-Host

                            Write-Host "Removing BUILTIN Users permissions..."

                            icacls $fixedKey /remove:g "BUILTIN\\Users" 2>$null | Out-Host

                            Write-Host "Removing Everyone permissions..."

                            icacls $fixedKey /remove:g "Everyone" 2>$null | Out-Host

                            Write-Host "Granting LocalSystem full access..."

                            icacls $fixedKey /grant:r "SYSTEM:(F)" | Out-Host

                            Write-Host "Granting Administrators full access..."

                            icacls $fixedKey /grant:r "Administrators:(F)" | Out-Host

                            Write-Host ""
                            Write-Host "Current SSH key permissions:"
                            icacls $fixedKey | Out-Host

                            # ----------------------------------------------------
                            # Prepare deploy.sh for Linux.
                            #
                            # Convert CRLF / CR to LF.
                            # Write UTF-8 without BOM.
                            # ----------------------------------------------------

                            $deployScript = Join-Path (Get-Location) "deploy.sh"

                            if (-not (Test-Path $deployScript)) {
                                throw "deploy.sh was not found: $deployScript"
                            }

                            Write-Host ""
                            Write-Host "Preparing deploy.sh for Linux..."

                            $bytes = [System.IO.File]::ReadAllBytes($deployScript)

                            $text = [System.Text.Encoding]::UTF8.GetString($bytes)

                            # Remove UTF-8 BOM if one exists.
                            $text = $text.TrimStart([char]0xFEFF)

                            # Convert CRLF to LF.
                            $text = $text.Replace("`r`n", "`n")

                            # Convert remaining CR to LF.
                            $text = $text.Replace("`r", "`n")

                            # Write UTF-8 without BOM.
                            [System.IO.File]::WriteAllText(
                                $deployScript,
                                $text,
                                [System.Text.UTF8Encoding]::new($false)
                            )

                            Write-Host "deploy.sh converted to Unix LF line endings."

                            # ----------------------------------------------------
                            # Verify the first bytes of deploy.sh.
                            # ----------------------------------------------------

                            $verifyBytes = [System.IO.File]::ReadAllBytes($deployScript)

                            if ($verifyBytes.Length -lt 2) {
                                throw "deploy.sh is unexpectedly empty."
                            }

                            Write-Host "deploy.sh size: $($verifyBytes.Length) bytes"

                            Write-Host ""
                            Write-Host "EC2 deployment files prepared successfully."
                        '''

                        // --------------------------------------------------------
                        // STEP 2:
                        // Test SSH using Windows BAT.
                        //
                        // This intentionally uses BAT instead of PowerShell
                        // because the previous build failed when PowerShell
                        // attempted to launch ssh.exe.
                        // --------------------------------------------------------

                        bat """
                            echo.
                            echo ==========================================================
                            echo TESTING SSH CONNECTION
                            echo ==========================================================

                            ssh ^
                                -o StrictHostKeyChecking=no ^
                                -o UserKnownHostsFile=NUL ^
                                -o ConnectTimeout=15 ^
                                -i "${env.WORKSPACE}\\${env.APP_DIR}\\ec2-deploy-key.pem" ^
                                "${params.EC2_USER}@${params.EC2_IP}" ^
                                "echo SSH_CONNECTION_SUCCESS"

                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: SSH connection to EC2 failed.
                                del /f /q "${env.WORKSPACE}\\${env.APP_DIR}\\ec2-deploy-key.pem" >nul 2>&1
                                exit /b 1
                            )

                            echo.
                            echo SSH connection successful.
                        """

                        // --------------------------------------------------------
                        // STEP 3:
                        // Copy deploy.sh to EC2.
                        // --------------------------------------------------------

                        bat """
                            echo.
                            echo ==========================================================
                            echo COPYING DEPLOYMENT SCRIPT TO EC2
                            echo ==========================================================

                            scp ^
                                -o StrictHostKeyChecking=no ^
                                -o UserKnownHostsFile=NUL ^
                                -o ConnectTimeout=15 ^
                                -i "${env.WORKSPACE}\\${env.APP_DIR}\\ec2-deploy-key.pem" ^
                                "deploy.sh" ^
                                "${params.EC2_USER}@${params.EC2_IP}:/home/${params.EC2_USER}/deploy.sh"

                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: SCP failed.
                                del /f /q "${env.WORKSPACE}\\${env.APP_DIR}\\ec2-deploy-key.pem" >nul 2>&1
                                exit /b 1
                            )

                            echo.
                            echo deploy.sh copied successfully.
                        """

                        // --------------------------------------------------------
                        // STEP 4:
                        // Run deployment on EC2.
                        //
                        // No /actuator/health check is used here.
                        // deploy.sh only verifies that the Docker container
                        // itself is running.
                        // --------------------------------------------------------

                        bat """
                            echo.
                            echo ==========================================================
                            echo RUNNING DEPLOYMENT ON EC2
                            echo ==========================================================

                            ssh ^
                                -o StrictHostKeyChecking=no ^
                                -o UserKnownHostsFile=NUL ^
                                -o ConnectTimeout=15 ^
                                -i "${env.WORKSPACE}\\${env.APP_DIR}\\ec2-deploy-key.pem" ^
                                "${params.EC2_USER}@${params.EC2_IP}" ^
                                "chmod +x /home/${params.EC2_USER}/deploy.sh && /home/${params.EC2_USER}/deploy.sh ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}"

                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: EC2 deployment failed.
                                del /f /q "${env.WORKSPACE}\\${env.APP_DIR}\\ec2-deploy-key.pem" >nul 2>&1
                                exit /b 1
                            )

                            echo.
                            echo ==========================================================
                            echo EC2 DEPLOYMENT SUCCESSFUL
                            echo ==========================================================

                            echo Application URL:
                            echo http://${params.EC2_IP}:${env.APP_PORT}

                            del /f /q "${env.WORKSPACE}\\${env.APP_DIR}\\ec2-deploy-key.pem" >nul 2>&1
                        """
                    }
                }
            }
        }

        // ============================================================
        // 9. OPTIONAL KUBERNETES DEPLOYMENT
        // ============================================================

        stage('Kubernetes Deploy') {

            when {
                expression {
                    return params.K8S_ENABLED == true
                }
            }

            steps {

                echo '=========================================================='
                echo 'KUBERNETES DEPLOYMENT'
                echo '=========================================================='

                echo 'Kubernetes deployment is enabled.'

                echo 'Kubernetes deployment commands can be added here.'
            }
        }
    }

    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        always {

            echo "CI/CD Pipeline finished for Build #${env.BUILD_NUMBER}"

            echo '=========================================================='
            echo 'CLEANING UNUSED LOCAL DOCKER IMAGES'
            echo '=========================================================='

            bat '''
                docker image prune -f
            '''
        }

        success {

            echo '=========================================================='
            echo 'PIPELINE SUCCESSFUL'
            echo '=========================================================='

            echo "Application deployed to:"
            echo "http://${params.EC2_IP}:${env.APP_PORT}"
        }

        failure {

            echo '=========================================================='
            echo 'PIPELINE FAILED'
            echo '=========================================================='

            echo 'Check the failed stage above.'

            echo '=========================================================='
        }
    }
}