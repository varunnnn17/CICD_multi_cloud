pipeline {
    agent any

    parameters {

        string(
            name: 'DOCKERHUB_USER',
            defaultValue: 'varun1716',
            description: 'Docker Hub username / namespace'
        )

        string(
            name: 'IMAGE_NAME',
            defaultValue: 'food-delivery',
            description: 'Docker image repository name'
        )

        string(
            name: 'EC2_IP',
            defaultValue: '100.62.122.237',
            description: 'AWS EC2 IP address for deployment'
        )

        string(
            name: 'EC2_USER',
            defaultValue: 'ubuntu',
            description: 'SSH username for EC2 instance'
        )

        string(
            name: 'APP_PORT',
            defaultValue: '8083',
            description: 'Application port'
        )

        booleanParam(
            name: 'K8S_ENABLED',
            defaultValue: false,
            description: 'Deploy to Kubernetes'
        )

        booleanParam(
            name: 'SONAR_ENABLED',
            defaultValue: false,
            description: 'Run SonarQube code analysis'
        )
    }

    environment {
        APP_NAME        = 'food-delivery'
        DOCKER_CRED_ID  = 'dockercred1'
        EC2_CRED_ID     = 'ec2-ssh-key'
        FULL_IMAGE_NAME = "${params.DOCKERHUB_USER}/${params.IMAGE_NAME}"
        TARGET_PORT     = "${params.APP_PORT}"
    }

    stages {

        stage('Environment Validation') {
            steps {
                echo "=========================================================="
                echo "CI/CD ENVIRONMENT VALIDATION"
                echo "=========================================================="
                echo "Jenkins Agent       : Windows"
                echo "Application Dir     : fooddeliveryapp"
                echo "Application Port    : ${params.APP_PORT}"
                echo "Docker Image        : ${FULL_IMAGE_NAME}:${BUILD_NUMBER}"
                echo "EC2 Host            : ${params.EC2_IP}"
                echo "EC2 User            : ${params.EC2_USER}"
                echo "=========================================================="

                bat '''
                    echo.
                    echo Checking Java...
                    java -version

                    echo.
                    echo Checking Docker...
                    docker --version

                    echo.
                    echo Checking Git...
                    git --version

                    echo.
                    echo Checking SSH...
                    ssh -V

                    echo.
                    echo Checking SCP...
                    where scp
                '''
            }
        }

        stage('Maven Test') {
            steps {
                dir('fooddeliveryapp') {

                    echo "=========================================================="
                    echo "RUNNING MAVEN TESTS"
                    echo "=========================================================="

                    bat '''
                        if not exist mvnw.cmd (
                            echo ERROR: mvnw.cmd not found.
                            exit /b 1
                        )

                        call mvnw.cmd clean test

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Maven tests failed.
                            exit /b 1
                        )

                        echo.
                        echo Maven tests completed successfully.
                    '''
                }
            }
        }

        stage('Maven Package') {
            steps {
                dir('fooddeliveryapp') {

                    echo "=========================================================="
                    echo "PACKAGING SPRING BOOT APPLICATION"
                    echo "=========================================================="

                    bat '''
                        call mvnw.cmd clean package -DskipTests=true

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Maven package failed.
                            exit /b 1
                        )

                        echo.
                        echo Generated JAR:
                        dir target\\*.jar
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            when {
                expression {
                    return params.SONAR_ENABLED
                }
            }

            steps {
                dir('fooddeliveryapp') {

                    echo "=========================================================="
                    echo "SONARQUBE ANALYSIS"
                    echo "=========================================================="

                    withSonarQubeEnv('sonarqube') {

                        bat '''
                            call mvnw.cmd sonar:sonar ^
                                -Dsonar.projectKey=food-delivery-app ^
                                -Dsonar.projectName=food-delivery-app

                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: SonarQube analysis failed.
                                exit /b 1
                            )
                        '''
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('fooddeliveryapp') {

                    echo "=========================================================="
                    echo "BUILDING DOCKER IMAGE"
                    echo "=========================================================="

                    bat """
                        docker build ^
                            -t ${FULL_IMAGE_NAME}:${BUILD_NUMBER} ^
                            -t ${FULL_IMAGE_NAME}:latest .

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker build failed.
                            exit /b 1
                        )

                        echo.
                        echo Docker build completed successfully.
                    """
                }
            }
        }

        stage('Docker Image Validation') {
            steps {
                dir('fooddeliveryapp') {

                    echo "=========================================================="
                    echo "VALIDATING DOCKER IMAGE"
                    echo "=========================================================="

                    bat """
                        docker image inspect ${FULL_IMAGE_NAME}:${BUILD_NUMBER}

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker image validation failed.
                            exit /b 1
                        )

                        echo.
                        echo Docker image validation successful.
                    """
                }
            }
        }

        stage('Docker Hub Push') {
            steps {

                echo "=========================================================="
                echo "PUSHING DOCKER IMAGE TO DOCKER HUB"
                echo "=========================================================="

                withCredentials([
                    usernamePassword(
                        credentialsId: env.DOCKER_CRED_ID,
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    bat """
                        echo Logging into Docker Hub...

                        echo %DOCKER_PASS% | docker login ^
                            -u %DOCKER_USER% ^
                            --password-stdin

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker Hub login failed.
                            exit /b 1
                        )

                        echo.
                        echo Pushing image:
                        echo ${FULL_IMAGE_NAME}:${BUILD_NUMBER}

                        docker push ${FULL_IMAGE_NAME}:${BUILD_NUMBER}

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker image push failed.
                            docker logout
                            exit /b 1
                        )

                        echo.
                        echo Pushing latest image:
                        echo ${FULL_IMAGE_NAME}:latest

                        docker push ${FULL_IMAGE_NAME}:latest

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker latest image push failed.
                            docker logout
                            exit /b 1
                        )

                        docker logout

                        echo.
                        echo Docker images pushed successfully.
                    """
                }
            }
        }

        stage('Deploy to AWS EC2') {
            steps {

                echo "=========================================================="
                echo "DEPLOYING TO AWS EC2"
                echo "=========================================================="
                echo "EC2 IP       : ${params.EC2_IP}"
                echo "EC2 User     : ${params.EC2_USER}"
                echo "Application  : ${params.APP_PORT}"
                echo "Docker Image : ${FULL_IMAGE_NAME}:${BUILD_NUMBER}"
                echo "=========================================================="

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: env.EC2_CRED_ID,
                        keyFileVariable: 'SSH_KEY_FILE',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {

                    dir('fooddeliveryapp') {

                        bat """
                            echo.
                            echo ==========================================================
                            echo PREPARING SSH PRIVATE KEY
                            echo ==========================================================

                            set "FIXED_KEY=%WORKSPACE%\\ec2-deploy-key.pem"

                            copy /Y "%SSH_KEY_FILE%" "%FIXED_KEY%"

                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: Failed to copy SSH private key.
                                exit /b 1
                            )

                            echo.
                            echo Removing inherited permissions...

                            icacls "%FIXED_KEY%" /inheritance:r

                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: Failed to remove inherited permissions.
                                del /f /q "%FIXED_KEY%" >nul 2>&1
                                exit /b 1
                            )

                            echo.
                            echo Removing BUILTIN Users permissions...

                            icacls "%FIXED_KEY%" /remove:g "BUILTIN\\Users"

                            echo.
                            echo Removing Everyone permissions...

                            icacls "%FIXED_KEY%" /remove:g "Everyone"

                            echo.
                            echo Granting LocalSystem full access...

                            icacls "%FIXED_KEY%" /grant:r "NT AUTHORITY\\SYSTEM:(F)"

                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: Failed to grant LocalSystem permissions.
                                del /f /q "%FIXED_KEY%" >nul 2>&1
                                exit /b 1
                            )

                            echo.
                            echo Granting Administrators full access...

                            icacls "%FIXED_KEY%" /grant:r "BUILTIN\\Administrators:(F)"

                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: Failed to grant Administrators permissions.
                                del /f /q "%FIXED_KEY%" >nul 2>&1
                                exit /b 1
                            )

                            echo.
                            echo Current SSH key permissions:

                            icacls "%FIXED_KEY%"

                            echo.
                            echo ==========================================================
                            echo TESTING SSH CONNECTION
                            echo ==========================================================

                            ssh ^
                                -o StrictHostKeyChecking=no ^
                                -o UserKnownHostsFile=NUL ^
                                -o ConnectTimeout=15 ^
                                -i "%FIXED_KEY%" ^
                                "%SSH_USER%@${params.EC2_IP}" ^
                                "echo SSH_CONNECTION_SUCCESS"

                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: SSH connection to EC2 failed.
                                del /f /q "%FIXED_KEY%" >nul 2>&1
                                exit /b 1
                            )

                            echo.
                            echo SSH connection successful.

                            echo.
                            echo ==========================================================
                            echo COPYING deploy.sh TO EC2
                            echo ==========================================================

                            scp ^
                                -o StrictHostKeyChecking=no ^
                                -o UserKnownHostsFile=NUL ^
                                -o ConnectTimeout=15 ^
                                -i "%FIXED_KEY%" ^
                                "deploy.sh" ^
                                "%SSH_USER%@${params.EC2_IP}:/home/%SSH_USER%/deploy.sh"

                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: SCP failed.
                                del /f /q "%FIXED_KEY%" >nul 2>&1
                                exit /b 1
                            )

                            echo.
                            echo deploy.sh copied successfully.

                            echo.
                            echo ==========================================================
                            echo RUNNING DEPLOYMENT ON EC2
                            echo ==========================================================

                            ssh ^
                                -o StrictHostKeyChecking=no ^
                                -o UserKnownHostsFile=NUL ^
                                -o ConnectTimeout=15 ^
                                -i "%FIXED_KEY%" ^
                                "%SSH_USER%@${params.EC2_IP}" ^
                                "chmod +x /home/%SSH_USER%/deploy.sh && /home/%SSH_USER%/deploy.sh ${FULL_IMAGE_NAME}:${BUILD_NUMBER}"

                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: EC2 deployment failed.
                                del /f /q "%FIXED_KEY%" >nul 2>&1
                                exit /b 1
                            )

                            echo.
                            echo ==========================================================
                            echo EC2 DEPLOYMENT SUCCESSFUL
                            echo ==========================================================

                            echo.
                            echo Application URL:
                            echo http://${params.EC2_IP}:${params.APP_PORT}

                            del /f /q "%FIXED_KEY%" >nul 2>&1

                            echo.
                            echo Temporary SSH key removed.
                        """
                    }
                }
            }
        }

        stage('Kubernetes Deploy') {
            when {
                expression {
                    return params.K8S_ENABLED
                }
            }

            steps {
                dir('fooddeliveryapp') {

                    echo "=========================================================="
                    echo "KUBERNETES DEPLOYMENT"
                    echo "=========================================================="

                    bat '''
                        kubectl version --client

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: kubectl command not found.
                            exit /b 1
                        )

                        kubectl cluster-info

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Cannot connect to Kubernetes cluster.
                            exit /b 1
                        )

                        kubectl apply -f k8s\\configmap.yaml
                        kubectl apply -f k8s\\deployment.yaml
                        kubectl apply -f k8s\\service.yaml

                        kubectl rollout status deployment/fooddelivery-deployment --timeout=180s

                        kubectl get svc fooddelivery-service
                    '''
                }
            }
        }
    }

    post {

        always {
            echo "CI/CD Pipeline finished for Build #${BUILD_NUMBER}"
        }

        success {
            echo "=========================================================="
            echo "PIPELINE SUCCESS"
            echo "=========================================================="
            echo "Food Delivery App deployed successfully."
            echo "EC2 IP       : ${params.EC2_IP}"
            echo "Application  : http://${params.EC2_IP}:${params.APP_PORT}"
            echo "Docker Image : ${FULL_IMAGE_NAME}:${BUILD_NUMBER}"
            echo "=========================================================="
        }

        failure {
            echo "=========================================================="
            echo "PIPELINE FAILED"
            echo "=========================================================="
            echo "Check the failed stage above."
            echo "=========================================================="
        }

        cleanup {
            echo "Cleaning unused local Docker images..."

            bat '''
                docker image prune -f
            '''
        }
    }
}