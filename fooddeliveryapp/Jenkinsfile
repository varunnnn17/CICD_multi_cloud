pipeline {

    agent any

    parameters {

        string(
            name: 'EC2_IP',
            defaultValue: '100.62.122.237',
            description: 'AWS EC2 IP address'
        )

        string(
            name: 'EC2_USER',
            defaultValue: 'ubuntu',
            description: 'AWS EC2 SSH username'
        )

        booleanParam(
            name: 'SONAR_ENABLED',
            defaultValue: false,
            description: 'Run SonarQube analysis'
        )

        booleanParam(
            name: 'K8S_ENABLED',
            defaultValue: false,
            description: 'Deploy to Kubernetes'
        )
    }

    environment {

        DOCKERHUB_USER = 'varun1716'
        IMAGE_NAME = 'food-delivery'

        APP_DIR = 'fooddeliveryapp'
        APP_PORT = '8083'

        DOCKER_CRED_ID = 'dockercred1'
        EC2_CRED_ID = 'ec2-ssh-key'

        SONAR_ENABLED_VALUE = "${params.SONAR_ENABLED}"
        K8S_ENABLED_VALUE = "${params.K8S_ENABLED}"
    }

    stages {

        stage('Environment Validation') {

            steps {

                echo '=========================================================='
                echo 'CI/CD ENVIRONMENT VALIDATION'
                echo '=========================================================='

                echo "Jenkins Agent       : Windows"
                echo "Application Dir     : ${env.APP_DIR}"
                echo "Application Port    : ${env.APP_PORT}"
                echo "Docker Image        : ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}"
                echo "EC2 Host            : ${params.EC2_IP}"
                echo "EC2 User            : ${params.EC2_USER}"

                bat '''
                    echo.
                    echo Checking Java...
                    java -version

                    echo.
                    echo Checking Docker...
                    docker --version

                    echo.
                    echo Checking Git...
                    git --version

                    echo.
                    echo Checking SSH...
                    ssh -V

                    echo.
                    echo Checking SCP...
                    where scp
                '''
            }
        }

        stage('Maven Test') {

            steps {

                dir("${env.APP_DIR}") {

                    echo '=========================================================='
                    echo 'RUNNING MAVEN TESTS'
                    echo '=========================================================='

                    bat '''
                        if not exist mvnw.cmd (
                            echo ERROR: mvnw.cmd not found.
                            exit /b 1
                        )

                        call mvnw.cmd clean test

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Maven tests failed.
                            exit /b 1
                        )

                        echo.
                        echo Maven tests completed successfully.
                    '''
                }
            }
        }

        stage('Maven Package') {

            steps {

                dir("${env.APP_DIR}") {

                    echo '=========================================================='
                    echo 'PACKAGING SPRING BOOT APPLICATION'
                    echo '=========================================================='

                    bat '''
                        call mvnw.cmd clean package -DskipTests=true

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Maven package failed.
                            exit /b 1
                        )

                        echo.
                        echo Generated JAR:
                        dir target\\*.jar
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {

            when {
                expression {
                    return params.SONAR_ENABLED
                }
            }

            steps {

                dir("${env.APP_DIR}") {

                    echo '=========================================================='
                    echo 'RUNNING SONARQUBE ANALYSIS'
                    echo '=========================================================='

                    bat '''
                        call mvnw.cmd sonar:sonar

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: SonarQube analysis failed.
                            exit /b 1
                        )
                    '''
                }
            }
        }

        stage('Docker Build') {

            steps {

                dir("${env.APP_DIR}") {

                    echo '=========================================================='
                    echo 'BUILDING DOCKER IMAGE'
                    echo '=========================================================='

                    bat """
                        docker build ^
                            -t ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER} ^
                            -t ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:latest .

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker build failed.
                            exit /b 1
                        )

                        echo.
                        echo Docker build completed successfully.
                    """
                }
            }
        }

        stage('Docker Image Validation') {

            steps {

                dir("${env.APP_DIR}") {

                    echo '=========================================================='
                    echo 'VALIDATING DOCKER IMAGE'
                    echo '=========================================================='

                    bat """
                        docker image inspect ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker image validation failed.
                            exit /b 1
                        )

                        echo.
                        echo Docker image validation successful.
                    """
                }
            }
        }

        stage('Docker Hub Push') {

            steps {

                echo '=========================================================='
                echo 'PUSHING DOCKER IMAGE TO DOCKER HUB'
                echo '=========================================================='

                withCredentials([
                    usernamePassword(
                        credentialsId: "${env.DOCKER_CRED_ID}",
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    bat """
                        echo Logging into Docker Hub...

                        echo %DOCKER_PASS% | docker login ^
                            -u %DOCKER_USER% ^
                            --password-stdin

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker Hub login failed.
                            exit /b 1
                        )

                        echo.
                        echo Pushing image:
                        echo ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}

                        docker push ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker image push failed.
                            docker logout
                            exit /b 1
                        )

                        echo.
                        echo Pushing latest image:
                        echo ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:latest

                        docker push ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:latest

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker latest image push failed.
                            docker logout
                            exit /b 1
                        )

                        docker logout

                        echo.
                        echo Docker images pushed successfully.
                    """
                }
            }
        }

        stage('Deploy to AWS EC2') {

            steps {

                echo '=========================================================='
                echo 'DEPLOYING TO AWS EC2'
                echo '=========================================================='

                echo "EC2 IP       : ${params.EC2_IP}"
                echo "EC2 User     : ${params.EC2_USER}"
                echo "Application  : ${env.APP_PORT}"
                echo "Docker Image : ${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}"

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: "${env.EC2_CRED_ID}",
                        keyFileVariable: 'SSH_KEY_FILE',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {

                    dir("${env.APP_DIR}") {

                        powershell(
                            script: """
                                \$ErrorActionPreference = 'Stop'

                                \$sourceKey = \$env:SSH_KEY_FILE
                                \$fixedKey = Join-Path \$env:WORKSPACE 'ec2-deploy-key.pem'

                                \$ec2Ip = '${params.EC2_IP}'
                                \$ec2User = '${params.EC2_USER}'
                                \$credentialUser = \$env:SSH_USER

                                if ([string]::IsNullOrWhiteSpace(\$credentialUser)) {
                                    \$credentialUser = \$ec2User
                                }

                                \$image = '${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:${env.BUILD_NUMBER}'

                                Write-Host '=========================================================='
                                Write-Host 'AWS EC2 DEPLOYMENT'
                                Write-Host '=========================================================='
                                Write-Host "EC2 Host     : \$ec2Ip"
                                Write-Host "EC2 User     : \$credentialUser"
                                Write-Host "Docker Image : \$image"
                                Write-Host ''

                                if (-not (Test-Path \$sourceKey)) {
                                    throw "Jenkins SSH private key was not found: \$sourceKey"
                                }

                                # --------------------------------------------------
                                # Prepare SSH private key
                                # --------------------------------------------------

                                Write-Host 'Preparing SSH private key...'

                                Copy-Item -Path \$sourceKey -Destination \$fixedKey -Force

                                if (-not (Test-Path \$fixedKey)) {
                                    throw 'Failed to create deployment SSH key.'
                                }

                                Write-Host 'Removing inherited permissions...'

                                & icacls \$fixedKey /inheritance:r

                                if (\$LASTEXITCODE -ne 0) {
                                    throw 'Failed to remove inherited permissions.'
                                }

                                Write-Host 'Removing BUILTIN Users permissions...'

                                & icacls \$fixedKey /remove:g 'BUILTIN\\Users' 2>\$null

                                Write-Host 'Removing Everyone permissions...'

                                & icacls \$fixedKey /remove:g 'Everyone' 2>\$null

                                Write-Host 'Granting LocalSystem full access...'

                                & icacls \$fixedKey /grant:r 'NT AUTHORITY\\SYSTEM:(F)'

                                if (\$LASTEXITCODE -ne 0) {
                                    throw 'Failed to grant LocalSystem permissions.'
                                }

                                Write-Host 'Granting Administrators full access...'

                                & icacls \$fixedKey /grant:r 'BUILTIN\\Administrators:(F)'

                                if (\$LASTEXITCODE -ne 0) {
                                    throw 'Failed to grant Administrators permissions.'
                                }

                                Write-Host ''
                                Write-Host 'Current SSH key permissions:'

                                & icacls \$fixedKey

                                # --------------------------------------------------
                                # Test SSH connection
                                # --------------------------------------------------

                                Write-Host ''
                                Write-Host '=========================================================='
                                Write-Host 'TESTING SSH CONNECTION'
                                Write-Host '=========================================================='

                                & ssh `
                                    -o StrictHostKeyChecking=no `
                                    -o UserKnownHostsFile=NUL `
                                    -o ConnectTimeout=15 `
                                    -i \$fixedKey `
                                    "\${credentialUser}@\${ec2Ip}" `
                                    'echo SSH_CONNECTION_SUCCESS'

                                if (\$LASTEXITCODE -ne 0) {
                                    throw 'SSH connection to EC2 failed.'
                                }

                                Write-Host 'SSH connection successful.'

                                # --------------------------------------------------
                                # Convert deploy.sh from Windows CRLF to Linux LF
                                # --------------------------------------------------

                                Write-Host ''
                                Write-Host '=========================================================='
                                Write-Host 'PREPARING deploy.sh FOR LINUX'
                                Write-Host '=========================================================='

                                \$deployScript = Join-Path (Get-Location) 'deploy.sh'

                                if (-not (Test-Path \$deployScript)) {
                                    throw "deploy.sh was not found: \$deployScript"
                                }

                                \$bytes = [System.IO.File]::ReadAllBytes(\$deployScript)

                                \$text = [System.Text.Encoding]::UTF8.GetString(\$bytes)

                                \$text = \$text.Replace("`r`n", "`n")
                                \$text = \$text.Replace("`r", "`n")

                                [System.IO.File]::WriteAllText(
                                    \$deployScript,
                                    \$text,
                                    [System.Text.UTF8Encoding]::new(\$false)
                                )

                                Write-Host 'deploy.sh converted to Linux LF line endings.'

                                # --------------------------------------------------
                                # Copy deploy.sh to EC2
                                # --------------------------------------------------

                                Write-Host ''
                                Write-Host '=========================================================='
                                Write-Host 'COPYING deploy.sh TO EC2'
                                Write-Host '=========================================================='

                                \$remoteDeployPath = "/home/\${credentialUser}/deploy.sh"

                                & scp `
                                    -o StrictHostKeyChecking=no `
                                    -o UserKnownHostsFile=NUL `
                                    -o ConnectTimeout=15 `
                                    -i \$fixedKey `
                                    \$deployScript `
                                    "\${credentialUser}@\${ec2Ip}:\${remoteDeployPath}"

                                if (\$LASTEXITCODE -ne 0) {
                                    throw 'SCP failed.'
                                }

                                Write-Host 'deploy.sh copied successfully.'

                                # --------------------------------------------------
                                # Run deployment on EC2
                                # --------------------------------------------------

                                Write-Host ''
                                Write-Host '=========================================================='
                                Write-Host 'RUNNING DEPLOYMENT ON EC2'
                                Write-Host '=========================================================='

                                \$remoteCommand = "chmod +x \${remoteDeployPath} && \${remoteDeployPath} \$image"

                                & ssh `
                                    -o StrictHostKeyChecking=no `
                                    -o UserKnownHostsFile=NUL `
                                    -o ConnectTimeout=15 `
                                    -i \$fixedKey `
                                    "\${credentialUser}@\${ec2Ip}" `
                                    \$remoteCommand

                                if (\$LASTEXITCODE -ne 0) {
                                    throw 'EC2 deployment failed.'
                                }

                                Write-Host ''
                                Write-Host '=========================================================='
                                Write-Host 'EC2 DEPLOYMENT SUCCESSFUL'
                                Write-Host '=========================================================='
                                Write-Host "Application URL:"
                                Write-Host "http://\${ec2Ip}:${env.APP_PORT}"

                                # --------------------------------------------------
                                # Remove temporary SSH key
                                # --------------------------------------------------

                                if (Test-Path \$fixedKey) {
                                    Remove-Item \$fixedKey -Force -ErrorAction SilentlyContinue
                                }
                            """
                        )
                    }
                }
            }
        }

        stage('Kubernetes Deploy') {

            when {
                expression {
                    return params.K8S_ENABLED
                }
            }

            steps {

                echo '=========================================================='
                echo 'KUBERNETES DEPLOYMENT'
                echo '=========================================================='

                echo 'Kubernetes deployment is enabled.'
                echo 'Add your Kubernetes deployment commands here.'
            }
        }
    }

    post {

        always {

            echo "CI/CD Pipeline finished for Build #${env.BUILD_NUMBER}"

            echo '=========================================================='
            echo 'Cleaning unused local Docker images...'
            echo '=========================================================='

            bat '''
                docker image prune -f
            '''
        }

        success {

            echo '=========================================================='
            echo 'PIPELINE SUCCESSFUL'
            echo '=========================================================='

            echo "Application deployed to:"
            echo "http://${params.EC2_IP}:${env.APP_PORT}"
        }

        failure {

            echo '=========================================================='
            echo 'PIPELINE FAILED'
            echo '=========================================================='

            echo 'Check the failed stage above.'

            echo '=========================================================='
        }
    }
}