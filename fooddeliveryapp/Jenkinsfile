pipeline {
    agent any

    parameters {

        string(
            name: 'DOCKERHUB_USER',
            defaultValue: 'varun1716',
            description: 'Docker Hub username / namespace'
        )

        string(
            name: 'IMAGE_NAME',
            defaultValue: 'food-delivery',
            description: 'Docker image repository name'
        )

        string(
            name: 'EC2_IP',
            defaultValue: '100.62.122.237',
            description: 'AWS EC2 Public IP address for deployment'
        )

        string(
            name: 'EC2_USER',
            defaultValue: 'ubuntu',
            description: 'SSH username for EC2 instance'
        )

        string(
            name: 'APP_PORT',
            defaultValue: '8083',
            description: 'Application port'
        )

        booleanParam(
            name: 'K8S_ENABLED',
            defaultValue: false,
            description: 'Deploy to Kubernetes'
        )

        booleanParam(
            name: 'SONAR_ENABLED',
            defaultValue: false,
            description: 'Run SonarQube code analysis'
        )
    }

    environment {
        APP_NAME        = 'food-delivery'
        DOCKER_CRED_ID  = 'dockercred1'
        EC2_CRED_ID     = 'ec2-ssh-key'
        FULL_IMAGE_NAME = "${params.DOCKERHUB_USER}/${params.IMAGE_NAME}"
        TARGET_PORT     = "${params.APP_PORT}"
    }

    stages {

        stage('Environment Validation') {
            steps {
                echo "=========================================================="
                echo "Validating CI/CD Pipeline Environment"
                echo "Jenkins Agent: Windows"
                echo "Application Directory: fooddeliveryapp"
                echo "Application Port: ${TARGET_PORT}"
                echo "Target Image: ${FULL_IMAGE_NAME}:${BUILD_NUMBER}"
                echo "EC2 Host: ${params.EC2_IP}"
                echo "=========================================================="

                bat '''
                    echo Checking Java...
                    java -version

                    echo.
                    echo Checking Docker...
                    docker --version

                    echo.
                    echo Checking Git...
                    git --version

                    echo.
                    echo Checking SSH...
                    ssh -V

                    echo.
                    echo Checking SCP...
                    where scp
                '''
            }
        }

        stage('Maven Test') {
            steps {
                dir('fooddeliveryapp') {
                    echo "--> Running Unit and Integration Tests..."

                    bat '''
                        if not exist mvnw.cmd (
                            echo ERROR: mvnw.cmd not found
                            exit /b 1
                        )

                        call mvnw.cmd clean test
                    '''
                }
            }
        }

        stage('Maven Package') {
            steps {
                dir('fooddeliveryapp') {
                    echo "--> Packaging Spring Boot Executable JAR..."

                    bat '''
                        call mvnw.cmd clean package -DskipTests=true

                        dir target\\*.jar
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            when {
                expression {
                    return params.SONAR_ENABLED == true
                }
            }

            steps {
                dir('fooddeliveryapp') {
                    echo "--> Executing SonarQube Scanner..."

                    script {
                        withSonarQubeEnv('sonarqube') {
                            bat '''
                                call mvnw.cmd sonar:sonar ^
                                    -Dsonar.projectKey=food-delivery-app ^
                                    -Dsonar.projectName=food-delivery-app
                            '''
                        }
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('fooddeliveryapp') {
                    echo "--> Building Docker Image..."

                    bat """
                        docker build -t ${FULL_IMAGE_NAME}:${BUILD_NUMBER} -t ${FULL_IMAGE_NAME}:latest .

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker build failed.
                            exit /b 1
                        )
                    """
                }
            }
        }

        stage('Docker Image Validation') {
            steps {
                dir('fooddeliveryapp') {
                    echo "--> Validating Docker Image..."

                    bat """
                        docker image inspect ${FULL_IMAGE_NAME}:${BUILD_NUMBER}

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker image validation failed.
                            exit /b 1
                        )

                        echo Docker image ${FULL_IMAGE_NAME}:${BUILD_NUMBER} successfully verified.
                    """
                }
            }
        }

        stage('Docker Hub Push') {
            steps {
                echo "--> Authenticating with Docker Hub and pushing image..."

                withCredentials([
                    usernamePassword(
                        credentialsId: env.DOCKER_CRED_ID,
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    bat """
                        echo Logging into Docker Hub...
                        echo %DOCKER_PASS% | docker login -u %DOCKER_USER% --password-stdin

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker Hub login failed.
                            exit /b 1
                        )

                        echo.
                        echo ==========================================================
                        echo Pushing build image: ${FULL_IMAGE_NAME}:${BUILD_NUMBER}
                        echo ==========================================================

                        docker push ${FULL_IMAGE_NAME}:${BUILD_NUMBER}

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker build image push failed.
                            docker logout
                            exit /b 1
                        )

                        echo.
                        echo ==========================================================
                        echo Pushing latest image: ${FULL_IMAGE_NAME}:latest
                        echo ==========================================================

                        docker push ${FULL_IMAGE_NAME}:latest

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker latest image push failed.
                            docker logout
                            exit /b 1
                        )

                        echo.
                        echo ==========================================================
                        echo Docker images pushed successfully
                        echo ==========================================================

                        docker logout

                        if %ERRORLEVEL% NEQ 0 (
                            echo WARNING: Docker logout returned a non-zero exit code.
                        )

                        exit /b 0
                    """
                }
            }
        }

        stage('Deploy to AWS EC2') {
            steps {
                echo "--> Deploying application to AWS EC2..."

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: env.EC2_CRED_ID,
                        keyFileVariable: 'SSH_KEY_FILE',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {

                    dir('fooddeliveryapp') {

                        powershell(
                            script: """
                                \\$ErrorActionPreference = 'Stop'

                                \\$sourceKey = \\$env:SSH_KEY_FILE
                                \\$remoteUser = \\$env:SSH_USER
                                \\$ec2Ip = '${params.EC2_IP}'
                                \\$imageName = '${FULL_IMAGE_NAME}:${BUILD_NUMBER}'

                                if ([string]::IsNullOrWhiteSpace(\\$remoteUser)) {
                                    \\$remoteUser = '${params.EC2_USER}'
                                }

                                Write-Host "=========================================================="
                                Write-Host "AWS EC2 DEPLOYMENT"
                                Write-Host "=========================================================="
                                Write-Host "Remote user : \\$remoteUser"
                                Write-Host "EC2 host    : \\$ec2Ip"
                                Write-Host "Docker image: \\$imageName"
                                Write-Host ""

                                if (-not (Test-Path \\$sourceKey)) {
                                    throw "Jenkins SSH private key was not found: \\$sourceKey"
                                }

                                # --------------------------------------------------
                                # Prepare deploy.sh for Linux
                                # Convert Windows CRLF line endings to Unix LF.
                                # --------------------------------------------------

                                Write-Host "Preparing deploy.sh for Linux..."

                                \\$deployScript = Join-Path (Get-Location) 'deploy.sh'

                                if (-not (Test-Path \\$deployScript)) {
                                    throw "deploy.sh was not found: \\$deployScript"
                                }

                                \\$deployContent = [System.IO.File]::ReadAllText(
                                    \\$deployScript,
                                    [System.Text.Encoding]::UTF8
                                )

                                # Remove Windows CR characters.
                                \\$deployContent = \\$deployContent -replace "`r`n", "`n"
                                \\$deployContent = \\$deployContent -replace "`r", "`n"

                                [System.IO.File]::WriteAllText(
                                    \\$deployScript,
                                    \\$deployContent,
                                    [System.Text.UTF8Encoding]::new(\\$false)
                                )

                                Write-Host "deploy.sh converted to Unix LF line endings."

                                # --------------------------------------------------
                                # Prepare SSH key
                                # --------------------------------------------------

                                Write-Host ""
                                Write-Host "Preparing local SSH key..."

                                \\$deployKey = Join-Path (Get-Location) 'jenkins-ec2-key.tmp'

                                Copy-Item `
                                    -Path \\$sourceKey `
                                    -Destination \\$deployKey `
                                    -Force

                                if (-not (Test-Path \\$deployKey)) {
                                    throw "Failed to create deployment SSH key: \\$deployKey"
                                }

                                Write-Host "Removing inherited permissions from deployment key..."

                                & icacls.exe \\$deployKey /inheritance:r

                                if (\\$LASTEXITCODE -ne 0) {
                                    throw "Failed to remove inherited permissions from deployment key."
                                }

                                Write-Host "Granting SYSTEM full access..."

                                & icacls.exe \\$deployKey /grant:r "SYSTEM:(F)"

                                if (\\$LASTEXITCODE -ne 0) {
                                    throw "Failed to grant SYSTEM access to deployment key."
                                }

                                Write-Host "Granting Administrators full access..."

                                & icacls.exe \\$deployKey /grant:r "Administrators:(F)"

                                if (\\$LASTEXITCODE -ne 0) {
                                    throw "Failed to grant Administrators access to deployment key."
                                }

                                Write-Host ""
                                Write-Host "Current deployment key permissions:"
                                & icacls.exe \\$deployKey

                                # --------------------------------------------------
                                # Test SSH
                                # --------------------------------------------------

                                Write-Host ""
                                Write-Host "=========================================================="
                                Write-Host "Testing SSH connection to EC2"
                                Write-Host "=========================================================="

                                & ssh.exe `
                                    -o StrictHostKeyChecking=no `
                                    -o UserKnownHostsFile=NUL `
                                    -o ConnectTimeout=15 `
                                    -i "\\$deployKey" `
                                    "\\${remoteUser}@\\${ec2Ip}" `
                                    "echo SSH_CONNECTION_SUCCESS"

                                if (\\$LASTEXITCODE -ne 0) {
                                    throw "SSH connection test failed with exit code \\$LASTEXITCODE."
                                }

                                # --------------------------------------------------
                                # Copy deploy.sh
                                # --------------------------------------------------

                                Write-Host ""
                                Write-Host "=========================================================="
                                Write-Host "Copying deploy.sh to EC2"
                                Write-Host "=========================================================="

                                & scp.exe `
                                    -o StrictHostKeyChecking=no `
                                    -o UserKnownHostsFile=NUL `
                                    -o ConnectTimeout=15 `
                                    -i "\\$deployKey" `
                                    "deploy.sh" `
                                    "\\${remoteUser}@\\${ec2Ip}:/home/\\${remoteUser}/deploy.sh"

                                if (\\$LASTEXITCODE -ne 0) {
                                    throw "SCP failed with exit code \\$LASTEXITCODE."
                                }

                                # --------------------------------------------------
                                # Verify Linux line endings remotely
                                # --------------------------------------------------

                                Write-Host ""
                                Write-Host "=========================================================="
                                Write-Host "Verifying deploy.sh on EC2"
                                Write-Host "=========================================================="

                                & ssh.exe `
                                    -o StrictHostKeyChecking=no `
                                    -o UserKnownHostsFile=NUL `
                                    -o ConnectTimeout=15 `
                                    -i "\\$deployKey" `
                                    "\\${remoteUser}@\\${ec2Ip}" `
                                    "file /home/\\${remoteUser}/deploy.sh && head -n 1 /home/\\${remoteUser}/deploy.sh"

                                if (\\$LASTEXITCODE -ne 0) {
                                    throw "Remote deploy.sh verification failed with exit code \\$LASTEXITCODE."
                                }

                                # --------------------------------------------------
                                # Execute deployment
                                # --------------------------------------------------

                                Write-Host ""
                                Write-Host "=========================================================="
                                Write-Host "Executing deployment on EC2"
                                Write-Host "=========================================================="

                                \\$remoteCommand = "chmod +x /home/\\${remoteUser}/deploy.sh && /home/\\${remoteUser}/deploy.sh \\$imageName"

                                & ssh.exe `
                                    -o StrictHostKeyChecking=no `
                                    -o UserKnownHostsFile=NUL `
                                    -o ConnectTimeout=15 `
                                    -i "\\$deployKey" `
                                    "\\${remoteUser}@\\${ec2Ip}" `
                                    \\$remoteCommand

                                if (\\$LASTEXITCODE -ne 0) {
                                    throw "EC2 deployment failed with exit code \\$LASTEXITCODE."
                                }

                                Write-Host ""
                                Write-Host "=========================================================="
                                Write-Host "EC2 DEPLOYMENT COMPLETED SUCCESSFULLY"
                                Write-Host "=========================================================="

                                # --------------------------------------------------
                                # Cleanup temporary SSH key
                                # --------------------------------------------------

                                if (Test-Path \\$deployKey) {
                                    Remove-Item `
                                        -Path \\$deployKey `
                                        -Force `
                                        -ErrorAction SilentlyContinue
                                }
                            """
                        )
                    }
                }
            }
        }

        stage('Kubernetes Deploy') {
            when {
                expression {
                    return params.K8S_ENABLED == true
                }
            }

            steps {
                dir('fooddeliveryapp') {
                    echo "--> Deploying to Kubernetes Cluster..."

                    bat '''
                        kubectl version --client

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: kubectl command not found.
                            exit /b 1
                        )

                        kubectl cluster-info

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Cannot connect to Kubernetes cluster.
                            exit /b 1
                        )

                        kubectl apply -f k8s\\configmap.yaml
                        kubectl apply -f k8s\\deployment.yaml
                        kubectl apply -f k8s\\service.yaml

                        kubectl rollout status deployment/fooddelivery-deployment --timeout=180s

                        kubectl get svc fooddelivery-service
                    '''
                }
            }
        }
    }

    post {

        always {
            echo "CI/CD Pipeline finished for Build #${BUILD_NUMBER}"
        }

        success {
            echo "=========================================================="
            echo "PIPELINE SUCCESS"
            echo "Food Delivery App deployed to EC2"
            echo "EC2 IP: ${params.EC2_IP}"
            echo "Port: ${TARGET_PORT}"
            echo "Application URL: http://${params.EC2_IP}:${params.APP_PORT}"
            echo "Docker Image: ${FULL_IMAGE_NAME}:${BUILD_NUMBER}"
            echo "=========================================================="
        }

        failure {
            echo "=========================================================="
            echo "PIPELINE FAILED"
            echo "Check the stage logs above for the exact error."
            echo "=========================================================="
        }

        cleanup {
            echo "Cleaning up local Docker images..."

            bat '''
                docker image prune -f
            '''
        }
    }
}