pipeline {
    agent any

    parameters {
        string(
            name: 'DOCKERHUB_USER',
            defaultValue: 'varun1716',
            description: 'Docker Hub username / namespace'
        )

        string(
            name: 'IMAGE_NAME',
            defaultValue: 'food-delivery',
            description: 'Docker image repository name'
        )

        string(
            name: 'EC2_IP',
            defaultValue: '3.89.36.223',
            description: 'AWS EC2 Public IP address for deployment'
        )

        string(
            name: 'EC2_USER',
            defaultValue: 'ubuntu',
            description: 'SSH username for EC2 instance'
        )

        string(
            name: 'APP_PORT',
            defaultValue: '8083',
            description: 'Application port'
        )

        booleanParam(
            name: 'K8S_ENABLED',
            defaultValue: false,
            description: 'Deploy to Kubernetes'
        )

        booleanParam(
            name: 'SONAR_ENABLED',
            defaultValue: false,
            description: 'Run SonarQube code analysis'
        )
    }

    environment {
        APP_NAME        = 'food-delivery'
        DOCKER_CRED_ID  = 'dockercred1'
        EC2_CRED_ID     = 'ec2-ssh-key'
        FULL_IMAGE_NAME = "${params.DOCKERHUB_USER}/${params.IMAGE_NAME}"
        TARGET_PORT     = "${params.APP_PORT}"
    }

    stages {

        stage('Environment Validation') {
            steps {
                echo "=========================================================="
                echo "Validating CI/CD Pipeline Environment"
                echo "Jenkins Agent: Windows"
                echo "Application Directory: fooddeliveryapp"
                echo "Application Port: ${TARGET_PORT}"
                echo "Target Image: ${FULL_IMAGE_NAME}:${BUILD_NUMBER}"
                echo "EC2 Host: ${params.EC2_IP}"
                echo "=========================================================="

                bat '''
                    echo Checking Java...
                    java -version

                    echo.
                    echo Checking Docker...
                    docker --version

                    echo.
                    echo Checking Git...
                    git --version

                    echo.
                    echo Checking SSH...
                    ssh -V

                    echo.
                    echo Checking SCP...
                    scp -V
                '''
            }
        }

        stage('Maven Test') {
            steps {
                dir('fooddeliveryapp') {
                    echo "--> Running Unit and Integration Tests..."

                    bat '''
                        if not exist mvnw.cmd (
                            echo ERROR: mvnw.cmd not found
                            exit /b 1
                        )

                        call mvnw.cmd clean test
                    '''
                }
            }
        }

        stage('Maven Package') {
            steps {
                dir('fooddeliveryapp') {
                    echo "--> Packaging Spring Boot Executable JAR..."

                    bat '''
                        call mvnw.cmd clean package -DskipTests=true

                        dir target\\*.jar
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            when {
                expression {
                    return params.SONAR_ENABLED == true
                }
            }

            steps {
                dir('fooddeliveryapp') {
                    echo "--> Executing SonarQube Scanner..."

                    script {
                        withSonarQubeEnv('sonarqube') {
                            bat '''
                                call mvnw.cmd sonar:sonar ^
                                    -Dsonar.projectKey=food-delivery-app ^
                                    -Dsonar.projectName=food-delivery-app
                            '''
                        }
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('fooddeliveryapp') {
                    echo "--> Building Docker Image..."

                    bat """
                        docker build -t ${FULL_IMAGE_NAME}:${BUILD_NUMBER} -t ${FULL_IMAGE_NAME}:latest .
                    """
                }
            }
        }

        stage('Docker Image Validation') {
            steps {
                dir('fooddeliveryapp') {
                    echo "--> Validating Docker Image..."

                    bat """
                        docker inspect ${FULL_IMAGE_NAME}:${BUILD_NUMBER}

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker image validation failed.
                            exit /b 1
                        )

                        echo Docker image ${FULL_IMAGE_NAME}:${BUILD_NUMBER} successfully verified.
                    """
                }
            }
        }

        stage('Docker Hub Push') {
            steps {
                echo "--> Authenticating with Docker Hub and pushing image..."

                withCredentials([
                    usernamePassword(
                        credentialsId: env.DOCKER_CRED_ID,
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    bat '''
                        echo %DOCKER_PASS% | docker login -u %DOCKER_USER% --password-stdin

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker Hub login failed.
                            exit /b 1
                        )

                        docker push %FULL_IMAGE_NAME%:%BUILD_NUMBER%

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker image push failed.
                            docker logout
                            exit /b 1
                        )

                        docker push %FULL_IMAGE_NAME%:latest

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Docker latest image push failed.
                            docker logout
                            exit /b 1
                        )

                        docker logout
                    '''
                }
            }
        }

        stage('Deploy to AWS EC2') {
            steps {
                echo "--> Deploying application to AWS EC2..."

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: env.EC2_CRED_ID,
                        keyFileVariable: 'SSH_KEY_FILE',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {

                    dir('fooddeliveryapp') {

                        bat """
                            echo Setting SSH key permissions...

                            echo.
                            echo Copying deploy.sh to EC2...

                            scp -o StrictHostKeyChecking=no -i "%SSH_KEY_FILE%" deploy.sh ${SSH_USER}@${params.EC2_IP}:/home/${SSH_USER}/deploy.sh

                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: SCP failed.
                                exit /b 1
                            )

                            echo.
                            echo Executing deployment script on EC2...

                            ssh -o StrictHostKeyChecking=no -i "%SSH_KEY_FILE%" ${SSH_USER}@${params.EC2_IP} "chmod +x /home/${SSH_USER}/deploy.sh && /home/${SSH_USER}/deploy.sh ${FULL_IMAGE_NAME}:${BUILD_NUMBER}"

                            if %ERRORLEVEL% NEQ 0 (
                                echo ERROR: EC2 deployment failed.
                                exit /b 1
                            )

                            echo.
                            echo EC2 deployment command completed successfully.
                        """
                    }
                }
            }
        }

        stage('EC2 Health Check') {
            steps {
                echo "--> Checking EC2 application health..."

                powershell(
                    script: """
                        \$healthUrl = "http://${params.EC2_IP}:${params.APP_PORT}/actuator/health"
                        \$maxAttempts = 12
                        \$sleepSeconds = 5
                        \$success = \$false

                        Write-Host "Health URL: \$healthUrl"

                        for (\$i = 1; \$i -le \$maxAttempts; \$i++) {
                            Write-Host "Attempt \$i of \$maxAttempts..."

                            try {
                                \$response = Invoke-WebRequest `
                                    -Uri \$healthUrl `
                                    -UseBasicParsing `
                                    -TimeoutSec 10 `
                                    -ErrorAction Stop

                                Write-Host "HTTP Status: \$([int]\$response.StatusCode)"

                                if ([int]\$response.StatusCode -eq 200) {
                                    Write-Host "Application health check returned HTTP 200 OK."
                                    \$success = \$true
                                    break
                                }
                            }
                            catch {
                                Write-Host "Health check failed: \$($_.Exception.Message)"
                            }

                            if (\$i -lt \$maxAttempts) {
                                Write-Host "Retrying in \$sleepSeconds seconds..."
                                Start-Sleep -Seconds \$sleepSeconds
                            }
                        }

                        if (-not \$success) {
                            Write-Host "=========================================================="
                            Write-Host "APPLICATION HEALTH CHECK FAILED"
                            Write-Host "=========================================================="
                            exit 1
                        }

                        Write-Host "=========================================================="
                        Write-Host "APPLICATION DEPLOYMENT SUCCESSFUL"
                        Write-Host "=========================================================="
                        Write-Host "Application URL:"
                        Write-Host "http://${params.EC2_IP}:${params.APP_PORT}"
                        Write-Host ""
                        Write-Host "Health URL:"
                        Write-Host "\$healthUrl"
                        Write-Host "=========================================================="
                    """
                )
            }
        }

        stage('Kubernetes Deploy') {
            when {
                expression {
                    return params.K8S_ENABLED == true
                }
            }

            steps {
                dir('fooddeliveryapp') {
                    echo "--> Deploying to Kubernetes Cluster..."

                    bat '''
                        kubectl version --client

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: kubectl command not found.
                            exit /b 1
                        )

                        kubectl cluster-info

                        if %ERRORLEVEL% NEQ 0 (
                            echo ERROR: Cannot connect to Kubernetes cluster.
                            exit /b 1
                        )

                        kubectl apply -f k8s\\configmap.yaml
                        kubectl apply -f k8s\\deployment.yaml
                        kubectl apply -f k8s\\service.yaml

                        kubectl rollout status deployment/fooddelivery-deployment --timeout=180s

                        kubectl get svc fooddelivery-service
                    '''
                }
            }
        }
    }

    post {

        always {
            echo "CI/CD Pipeline finished for Build #${BUILD_NUMBER}"
        }

        success {
            echo "=========================================================="
            echo "PIPELINE SUCCESS"
            echo "Food Delivery App deployed to EC2"
            echo "Port: ${TARGET_PORT}"
            echo "Docker Image: ${FULL_IMAGE_NAME}:${BUILD_NUMBER}"
            echo "=========================================================="
        }

        failure {
            echo "=========================================================="
            echo "PIPELINE FAILED"
            echo "Check the stage logs above for the exact error."
            echo "=========================================================="
        }

        cleanup {
            echo "Cleaning up local Docker images..."

            bat '''
                docker image prune -f
            '''
        }
    }
}