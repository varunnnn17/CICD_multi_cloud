# ==============================================================================
# Food Delivery Application - Environment Configuration
# ==============================================================================

# Application Port (Default: 8083, never use Jenkins port 8082)
SERVER_PORT=8083

# Spring Profiles: default (in-memory H2) or prod
SPRING_PROFILES_ACTIVE=default

# Database Configuration (Optional: default uses in-memory H2)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/fooddb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
# SPRING_DATASOURCE_USERNAME=fooduser
# SPRING_DATASOURCE_PASSWORD=your_secure_password
# SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect
# SPRING_JPA_HIBERNATE_DDL_AUTO=update

# AWS EC2 Deployment Configuration
EC2_HOST=3.89.36.223
EC2_USER=ubuntu
EC2_PORT=8083
